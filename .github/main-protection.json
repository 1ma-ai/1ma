{
  "$comment": "What GitHub enforces for main of this repository. Compared and applied by scripts/protect-main.mjs, which says what is covered; scripts/lib/workflows.test.mjs holds the check names equal to the job names in the workflows. An on/off setting of the branch that is not named here is expected to be off.",
  "repository": "1ma-ai/1ma",
  "branch": "main",
  "actions": {
    "enabled": true,
    "allowed_actions": "all",
    "sha_pinning_required": true
  },
  "protection": {
    "required_status_checks": {
      "strict": false,
      "checks": [
        { "context": "Lint, typecheck, test, build", "app_id": 15368 },
        { "context": "Workflow files are valid", "app_id": 15368 },
        { "context": "Desktop result", "app_id": 15368 },
        { "context": "Desktop bb tests result", "app_id": 15368 },
        { "context": "Bots end-to-end result", "app_id": 15368 }
      ]
    },
    "enforce_admins": true,
    "required_pull_request_reviews": null,
    "restrictions": null,
    "required_linear_history": false,
    "allow_force_pushes": false,
    "allow_deletions": false,
    "required_conversation_resolution": false,
    "block_creations": false,
    "lock_branch": false,
    "allow_fork_syncing": false
  },
  "required_signatures": false,
  "rules": []
}
