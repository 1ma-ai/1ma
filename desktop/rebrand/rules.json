{
  "$comment": "Rules for renaming the product bb to 1ma in the prepared bb tree. See desktop/rebrand/README.md and ADR-0005.",
  "replacement": "1ma",
  "roots": ["apps", "packages", "plugins", "tests"],
  "skipDirectories": ["node_modules", "dist", "build", "release", ".turbo", ".git", "coverage"],
