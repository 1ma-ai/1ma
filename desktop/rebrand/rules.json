      "reason": "names the bb command on PATH, which keeps its name until the CLI is renamed (phase 3)"
    },
    {
      "text": "submit a BB plugin to the Community marketplace",
      "reason": "the Community marketplace is bb's community registry, a bb cloud service (phase 2)"
    },
    {
      "text": "bb calls",
      "reason": "calls to the bb object of the MCP code sandbox (bb.cli, bb.json), an identifier in the snippet"
    }
  ],
  "replace": [
    {
      "text": "Written by bb: runs the bb command of the bb installed on this computer.",
      "to": "Written by 1ma: runs the bb command of the 1ma installed on this computer.",
      "reason": "CLI launcher marker: 1ma must not take over the bb command of a bb installed on the same computer; the CLI keeps its bb name until phase 3"
    },
    {
      "text": "BB Official",
      "to": "Built-in",
      "reason": "The bb team writes the built-in plugins; 1ma labels them neutrally instead of claiming them"
    },
    {
      "text": "Reloaded running bb server config.",
      "to": "Reloaded running 1ma server config.",
      "reason": "prose about the running server, not the bb server config command; the next message already says 1ma"
    },
    {
      "text": "bb project id (proj_",
      "to": "1ma project id (proj_",
      "reason": "the id of a project in the app, not the bb project id command; the same plugin says 'never a 1ma project id'"
    }
  ],
  "testReplace": [
    {
      "file": "apps/app/src/views/ToolsView.plugin-detail.test.tsx",
      "find": "/^BB/u",
      "replace": "/^Built-in/u",
      "reason": "the author page heading of built-in plugins reads Built-in; a two-letter pattern is too short to follow the source automatically"
    },
    {
      "file": "plugins/automations/src/composer.test.ts",
      "find": "label: \"spec\", from: 36, to: 41 }",
      "replace": "label: \"spec\", from: 37, to: 42 }",
      "reason": "the mention offsets count the characters of the renamed prompt prefix, which is one character longer"
    },
    {
      "file": "apps/app/src/components/settings/UpdatesSettingsSection.test.tsx",
      "find": "getByRole(\"region\", { name: \"bb\" })",
      "replace": "getByRole(\"region\", { name: \"1ma\" })",
      "reason": "the updates card for the app itself is labelled with the product name; single words in tests are data elsewhere (project names, provider filters) and never follow automatically"
    },
    {
      "file": "plugins/bb-guide/app.test.ts",
      "find": "label: \"spec\", from: 34, to: 39 }",
      "replace": "label: \"spec\", from: 35, to: 40 }",
      "reason": "the mention offsets count the characters of the renamed prompt prefix, which is one character longer"
    },
    {
      "file": "apps/app/src/views/ToolsView.plugin-detail.test.tsx",
      "find": "expect(alertText).not.toContain(\"Restart bb\");",
      "replace": "expect(alertText).not.toContain(\"Restart 1ma\");",
      "reason": "the degraded banner must not tell the user to restart the app; in 1ma that text would read Restart 1ma, so the old wording would make the check pass without testing anything"
    }
  ],
  "testKeep": [
    {
      "file": "apps/app/src/components/settings/ProjectsSettingsSection.test.tsx",
      "text": "Open bb settings",
      "reason": "the project in this test is named bb, and the link reads Open <project> settings"
    }
  ],
  "derived": [
    {
      "run": "packages/plugin-registry/scripts/build-registry.mjs",
      "writes": "packages/plugin-registry/r",
      "reason": "bb generates the plugin component registry from sources and descriptions the rebrand changes; its test and typecheck fail on a stale registry"
    }
  ]
