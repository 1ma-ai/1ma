From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 1ma <hello@1ma.ai>
Date: Sat, 31 Oct 2026 12:07:07 +0100
Subject: [PATCH] 1ma: ~/.1ma data directory and telemetry off by default

1ma keeps its server data in ~/.1ma so it can sit next to an existing bb
install without sharing a database, and it sends no usage telemetry unless
the user sets BB_TELEMETRY=true. Tests follow the new defaults.
---
 apps/desktop/src/main.ts            | 2 +-
 packages/bb-app/test/index.test.ts  | 6 +++---
 packages/config/src/env-vars.ts     | 2 +-
 packages/config/src/runtime.ts      | 2 +-
 packages/config/test/config.test.ts | 6 +++---
 5 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/apps/desktop/src/main.ts b/apps/desktop/src/main.ts
index 27863ca..a8dced8 100644
--- a/apps/desktop/src/main.ts
+++ b/apps/desktop/src/main.ts
@@ -662,7 +662,7 @@ const desktopLogger = createDesktopLogger({ logDir: formatLogDirectory() });
 function resolveDataDirFromEnv(args: ResolveDataDirFromEnvArgs): string {
   const rawDataDir = args.env.BB_DATA_DIR?.trim();
   if (rawDataDir === undefined || rawDataDir.length === 0) {
-    return join(args.homeDir, ".bb");
+    return join(args.homeDir, ".1ma");
   }
   if (rawDataDir === "~") {
     return args.homeDir;
