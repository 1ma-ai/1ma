diff --git a/apps/desktop/test/bb-connect-off.test.ts b/apps/desktop/test/bb-connect-off.test.ts
new file mode 100644
index 0000000..645e79c
--- /dev/null
+++ b/apps/desktop/test/bb-connect-off.test.ts
@@ -0,0 +1,85 @@
+import { describe, expect, it, vi } from "vitest";
+import {
+  forgetBbConnect,
+  type ForgetCookie,
+  type ForgetCookieStore,
+} from "../src/bb-connect-off.js";
+
+function cookieJar(cookies: ForgetCookie[]): ForgetCookieStore & {
+  left(): string[];
+} {
+  let jar = [...cookies];
+  return {
+    async get({ name }) {
+      return jar.filter((cookie) => cookie.name === name);
+    },
+    async remove(url, name) {
+      const host = new URL(url).hostname;
+      jar = jar.filter((cookie) => {
+        const domain = (cookie.domain ?? "").replace(/^\./, "");
+        return !(
+          cookie.name === name &&
+          (host === domain || host.endsWith(`.${domain}`))
+        );
+      });
+    },
+    left() {
+      return jar.map((cookie) => `${cookie.domain}|${cookie.name}`);
+    },
+  };
+}
+
+describe("forgetBbConnect", () => {
+  it("deletes bb connect sessions and account sign-ins from both stores, and nothing else", async () => {
+    const appCookies = cookieJar([
+      { domain: "getbb.app", name: "__Secure-better-auth.session_token" },
+      { domain: "accounts.elsewhere.dev", name: "__Secure-better-auth.session_token" },
+      { domain: "studio.getbb.app", name: "__Secure-bb-connect.desktop_session" },
+      { domain: "localhost", name: "bb-connect.desktop_session", secure: false },
+      { domain: "example.com", name: "session" },
+    ]);
+    const browserCookies = cookieJar([
+      { domain: "box.corp-connect.dev", name: "__Secure-bb-connect.desktop_session" },
+      { domain: "corp-connect.dev", name: "__Secure-better-auth.session_token" },
+      { domain: "getbb.app", name: "__Secure-better-auth.session_token" },
+      { domain: "other-saas.com", name: "__Secure-better-auth.session_token" },
+      { domain: "example.com", name: "session" },
+    ]);
+    const credentialCache = {
+      clear: vi.fn(async () => undefined),
+      read: vi.fn(async () => null),
+    };
+
+    await forgetBbConnect({
+      appCookies,
+      browserCookies,
+      credentialCache,
+      defaultAccountUrl: "https://getbb.app",
+      forgottenServerUrls: ["not a url"],
+    });
+
+    expect(credentialCache.clear).toHaveBeenCalledOnce();
+    expect(credentialCache.read).not.toHaveBeenCalled();
+    expect(appCookies.left()).toEqual(["example.com|session"]);
+    expect(browserCookies.left()).toEqual([
+      "other-saas.com|__Secure-better-auth.session_token",
+      "example.com|session",
+    ]);
+  });
+
+  it("finds the account site behind a forgotten connect server", async () => {
+    const browserCookies = cookieJar([
+      { domain: "connect.example.dev", name: "__Secure-better-auth.session_token" },
+    ]);
+
+    await forgetBbConnect({
+      appCookies: cookieJar([]),
+      browserCookies,
+      credentialCache: { clear: async () => undefined },
+      defaultAccountUrl: "https://getbb.app",
+      forgottenServerUrls: ["https://studio.connect.example.dev"],
+    });
+
+    expect(browserCookies.left()).toEqual([]);
+  });
+});
