index 0000000..5547166
--- /dev/null
+++ b/apps/desktop/src/bb-connect-off.ts
@@ -0,0 +1,84 @@
+import { deriveConnectBaseUrl } from "@bb/connect-client";
+import type { ConnectCredentialCache } from "./connect-credential-cache.js";
+
+/** Cookies bb connect gives the desktop app for a connect server. */
+const DESKTOP_SESSION_COOKIES = [
+  "__Secure-bb-connect.desktop_session",
+  "bb-connect.desktop_session",
+] as const;
+/** The bb account sign-in, on the account site. */
+const ACCOUNT_SESSION_COOKIES = [
+  "__Secure-better-auth.session_token",
+  "better-auth.session_token",
+] as const;
+
+export interface ForgetCookie {
+  domain?: string;
+  name: string;
+  path?: string;
+  secure?: boolean;
+}
+
+export interface ForgetCookieStore {
+  get(filter: { name: string }): Promise<readonly ForgetCookie[]>;
+  remove(url: string, name: string): Promise<void>;
+}
+
+/**
+ * In a build without bb connect, deletes what an earlier bb or 1ma kept for
+ * it on this computer:
+ * - the machine credential, deleted without being read (reading asks the OS
+ *   keychain, which can prompt on an unsigned build);
+ * - bb connect desktop sessions in the app's and the built-in browser's
+ *   cookie stores, found by their bb-only names;
+ * - the bb account sign-in. The app's own store holds only bb server pages
+ *   and the bb connect sign-in window, so every account session cookie there
+ *   goes. The built-in browser also holds the user's own sites, so there it
+ *   goes only on bb account sites known from the default, a forgotten connect
+ *   server or a desktop session cookie.
+ */
+export async function forgetBbConnect(args: {
+  appCookies: ForgetCookieStore;
+  browserCookies: ForgetCookieStore;
+  credentialCache: Pick<ConnectCredentialCache, "clear">;
+  defaultAccountUrl: string;
+  forgottenServerUrls: readonly string[];
+}): Promise<void> {
+  await args.credentialCache.clear();
+  const serverUrls = [...args.forgottenServerUrls];
+  for (const store of [args.appCookies, args.browserCookies]) {
+    for (const name of DESKTOP_SESSION_COOKIES) {
+      for (const cookie of await store.get({ name })) {
+        const url = cookieUrl(cookie);
+        if (url === null) continue;
+        await store.remove(url, name);
+        serverUrls.push(url);
+      }
+    }
+  }
+  for (const name of ACCOUNT_SESSION_COOKIES) {
+    for (const cookie of await args.appCookies.get({ name })) {
+      const url = cookieUrl(cookie);
+      if (url !== null) await args.appCookies.remove(url, name);
+    }
+  }
+  const accountUrls = new Set([args.defaultAccountUrl]);
+  for (const serverUrl of serverUrls) {
+    try {
+      accountUrls.add(deriveConnectBaseUrl(serverUrl));
+    } catch {
+      // Not a URL: no cookie can belong to it.
+    }
+  }
+  for (const accountUrl of accountUrls) {
+    for (const name of ACCOUNT_SESSION_COOKIES) {
+      await args.browserCookies.remove(accountUrl, name);
+    }
+  }
+}
+
+function cookieUrl(cookie: ForgetCookie): string | null {
+  const host = cookie.domain?.replace(/^\./, "");
+  if (host === undefined || host === "") return null;
+  return `${cookie.secure === false ? "http" : "https"}://${host}${cookie.path ?? "/"}`;
+}
