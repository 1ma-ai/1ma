+/**
+ * A cookie store with Chromium's rules: a cookie is its name, domain (with a
+ * leading dot for a domain cookie) and path; setting an expired cookie deletes
+ * the one with the same identity; removing by URL deletes every same-named
+ * cookie that URL would send, parent domains included. Changes reach the disk
+ * only on flushStore(), which can also report success without writing, as
+ * Chromium does when SQLite fails; restart() reads the disk back, as after a
+ * crash.
+ */
+function cookieJar(
+  cookies: ForgetCookie[],
+  power: { crashAt: number; flushes: number; loseWrites?: boolean } = {
+    crashAt: Infinity,
+    flushes: 0,
+  },
+): ForgetCookieStore & {
+  left(): string[];
+  onDisk(): string[];
+  restart(): void;
+  failNextWrite(): void;
+  remove(url: string, name: string): Promise<void>;
+} {
+  let jar = [...cookies];
+  let disk = [...cookies];
+  let fail = false;
+  const failIfAsked = () => {
+    if (fail) {
+      fail = false;
+      throw new Error("cookie store unavailable");
+    }
+  };
+  const names = (list: ForgetCookie[]) =>
+    list.map((cookie) => `${cookie.domain}|${cookie.name}`);
+  return {
+    async flushStore() {
+      power.flushes += 1;
+      if (power.flushes === power.crashAt) throw new Error("crash");
+      if (power.loseWrites === true) return;
+      disk = [...jar];
+    },
+    async get({ name }) {
+      return jar.filter((cookie) => cookie.name === name);
+    },
+    async set(details) {
+      failIfAsked();
+      const domain =
+        details.domain === undefined
+          ? new URL(details.url).hostname
+          : `.${details.domain.replace(/^\./, "")}`;
+      const path = details.path ?? "/";
+      const same = (cookie: ForgetCookie) =>
+        cookie.name === details.name &&
+        cookie.domain === domain &&
+        (cookie.path ?? "/") === path;
+      jar = jar.filter((cookie) => !same(cookie));
+      if (details.expirationDate * 1000 > Date.now()) {
+        jar.push({ domain, name: details.name, path });
+      }
+    },
+    async remove(url, name) {
+      failIfAsked();
+      const host = new URL(url).hostname;
+      jar = jar.filter((cookie) => {
+        const domain = (cookie.domain ?? "").replace(/^\./, "");
+        return !(
+          cookie.name === name &&
+          (host === domain || host.endsWith(`.${domain}`))
+        );
+      });
+    },
+    left() {
+      return names(jar);
+    },
+    onDisk() {
+      return names(disk);
+    },
+    restart() {
+      jar = [...disk];
+    },
+    failNextWrite() {
+      fail = true;
+    },
+  };
+}
