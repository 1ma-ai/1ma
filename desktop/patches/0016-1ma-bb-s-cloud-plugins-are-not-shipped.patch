+++ b/apps/desktop/src/bb-connect-off.ts
@@ -0,0 +1,15 @@
+import type { ConnectCredentialCache } from "./connect-credential-cache.js";
+
+/**
+ * In a build without bb connect, deletes what an earlier bb or 1ma kept for
+ * it on this computer: the machine credential and the bb account sign-in.
+ */
+export async function forgetBbConnect(args: {
+  accountUrl: string;
+  cookieName: string;
+  credentialCache: Pick<ConnectCredentialCache, "clear">;
+  removeCookie(url: string, name: string): Promise<void>;
+}): Promise<void> {
+  await args.credentialCache.clear();
+  await args.removeCookie(args.accountUrl, args.cookieName);
+}
