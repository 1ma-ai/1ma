diff --git a/apps/desktop/src/bb-connect-off.ts b/apps/desktop/src/bb-connect-off.ts
new file mode 100644
index 0000000..ed05e7a
--- /dev/null
+++ b/apps/desktop/src/bb-connect-off.ts
@@ -0,0 +1,208 @@
+import { mkdir, open, readFile, rename, rm } from "node:fs/promises";
+import { join } from "node:path";
+import { deriveConnectBaseUrl } from "@bb/connect-client";
+import type { ConnectCredentialCache } from "./connect-credential-cache.js";
+
+/** Cookies bb connect gives the desktop app; their domain is connect's base domain. */
+const DESKTOP_SESSION_COOKIES = [
+  "__Secure-bb-connect.desktop_session",
+  "bb-connect.desktop_session",
+] as const;
+/** The bb account sign-in, on the account site (connect's base domain). */
+const ACCOUNT_SESSION_COOKIES = [
+  "__Secure-better-auth.session_token",
+  "better-auth.session_token",
+] as const;
+
+export interface ForgetCookie {
+  domain?: string;
+  httpOnly?: boolean;
+  name: string;
+  path?: string;
+  secure?: boolean;
+}
+
+export interface ForgetCookieStore {
+  /** Writes the deletions to disk; until then a crash brings the cookies back. */
+  flushStore(): Promise<void>;
+  get(filter: { name: string }): Promise<readonly ForgetCookie[]>;
+  set(details: {
+    domain?: string;
+    expirationDate: number;
+    httpOnly?: boolean;
+    name: string;
+    path?: string;
+    secure?: boolean;
+    url: string;
+    value: string;
+  }): Promise<void>;
+}
+
+/** The bb account sites whose sign-ins 1ma deletes; host names only, kept for good. */
+export interface ForgottenBbSites {
+  read(): Promise<readonly string[]>;
+  write(hosts: readonly string[]): Promise<void>;
+}
+
+/**
+ * Keeps the sites in `forgotten-bb-sites.json` in the user data folder. The
+ * file is written in full and synced before it replaces the old one, so a
+ * crash leaves either the old list or the new one.
+ */
+export function createForgottenBbSitesFile(
+  userDataPath: string,
+): ForgottenBbSites {
+  const path = join(userDataPath, "forgotten-bb-sites.json");
+  return {
+    async read() {
+      let text: string;
+      try {
+        text = await readFile(path, "utf8");
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code === "ENOENT") return [];
+        throw error;
+      }
+      try {
+        const hosts: unknown = (JSON.parse(text) as { hosts?: unknown }).hosts;
+        return Array.isArray(hosts)
+          ? hosts.filter((host): host is string => typeof host === "string")
+          : [];
+      } catch {
+        return [];
+      }
+    },
+    async write(hosts) {
+      await mkdir(userDataPath, { recursive: true });
+      const temporaryPath = `${path}.tmp`;
+      try {
+        const file = await open(temporaryPath, "w");
+        try {
+          await file.writeFile(`${JSON.stringify({ hosts }, null, 2)}\n`);
+          await file.sync();
+        } finally {
+          await file.close();
+        }
+        await rename(temporaryPath, path);
+      } finally {
+        await rm(temporaryPath, { force: true });
+      }
+      if (process.platform !== "win32") {
+        const folder = await open(userDataPath, "r");
+        try {
+          await folder.sync();
+        } finally {
+          await folder.close();
+        }
+      }
+    },
+  };
+}
+
+/**
+ * In a build without bb connect, deletes what an earlier bb or 1ma kept for
+ * it on this computer: the bb account sign-in, bb connect desktop sessions
+ * and the machine credential, in the app's and the built-in browser's cookie
+ * stores (the two stores bb wrote them to).
+ *
+ * Account sign-ins are removed only when their own domain is a bb account
+ * site; the same cookie name on any other domain, a parent domain included,
+ * belongs to someone else. The sites come from the default, a forgotten
+ * connect server, the stored credential and desktop session cookies, and are
+ * saved for good before anything is deleted: every start deletes the sign-ins
+ * on every site ever seen, so a cleanup that a crash, a failed disk write or
+ * a locked keychain stopped finishes on a later start. The credential is
+ * cleared only while the system keychain can read it.
+ */
+export async function forgetBbConnect(args: {
+  appCookies: ForgetCookieStore;
+  browserCookies: ForgetCookieStore;
+  credentialCache: Pick<
+    ConnectCredentialCache,
+    "canPersist" | "clear" | "read"
+  >;
+  defaultAccountUrl: string;
+  forgottenServerUrls: readonly string[];
+  knownSites: ForgottenBbSites;
+}): Promise<void> {
+  const stores = [args.appCookies, args.browserCookies];
+  const remembered = await args.knownSites.read();
+  const accountHosts = new Set([
+    ...remembered,
+    new URL(args.defaultAccountUrl).hostname,
+  ]);
+  const credential = await args.credentialCache.read();
+  for (const serverUrl of [
+    ...args.forgottenServerUrls,
+    ...(credential === null ? [] : [credential.serverUrl]),
+  ]) {
+    try {
+      accountHosts.add(new URL(deriveConnectBaseUrl(serverUrl)).hostname);
+    } catch {
+      // Not a URL: no cookie can belong to it.
+    }
+  }
+  const sessions: { store: ForgetCookieStore; cookie: ForgetCookie }[] = [];
+  for (const store of stores) {
+    for (const name of DESKTOP_SESSION_COOKIES) {
+      for (const cookie of await store.get({ name })) {
+        const host = cookieHost(cookie);
+        if (host === null) continue;
+        sessions.push({ store, cookie });
+        accountHosts.add(host);
+      }
+    }
+  }
+  if ([...accountHosts].some((host) => !remembered.includes(host))) {
+    await args.knownSites.write([...accountHosts].sort());
+  }
+  for (const store of stores) {
+    for (const name of ACCOUNT_SESSION_COOKIES) {
+      for (const cookie of await store.get({ name })) {
+        const host = cookieHost(cookie);
+        if (host !== null && accountHosts.has(host)) {
+          await expireCookie(store, cookie, host);
+        }
+      }
+    }
+  }
+  for (const { store, cookie } of sessions) {
+    const host = cookieHost(cookie);
+    if (host !== null) await expireCookie(store, cookie, host);
+  }
+  await flush(stores);
+  if (args.credentialCache.canPersist()) {
+    await args.credentialCache.clear();
+  }
+}
+
+async function flush(stores: readonly ForgetCookieStore[]): Promise<void> {
+  for (const store of stores) await store.flushStore();
+}
+
+function cookieHost(cookie: ForgetCookie): string | null {
+  const host = cookie.domain?.replace(/^\./, "").toLowerCase();
+  return host === undefined || host === "" ? null : host;
+}
+
+/**
+ * Removes exactly this cookie. Chromium's remove-by-URL also takes same-named
+ * cookies of parent domains; an already expired cookie with the same name,
+ * domain and path replaces only this one, and is not stored.
+ */
+async function expireCookie(
+  store: ForgetCookieStore,
+  cookie: ForgetCookie,
+  host: string,
+): Promise<void> {
+  const path = cookie.path ?? "/";
+  await store.set({
+    ...(cookie.domain?.startsWith(".") ? { domain: cookie.domain } : {}),
+    expirationDate: 1,
+    httpOnly: cookie.httpOnly,
+    name: cookie.name,
+    path,
+    secure: cookie.secure,
+    url: `${cookie.secure === false ? "http" : "https"}://${host}${path}`,
+    value: "",
+  });
+}
