+  return {
+    canPersist() {
+      return keychain;
+    },
+    async read() {
+      return keychain ? stored : null;
+    },
+    async clear() {
+      stored = null;
+    },
+    exists() {
+      return stored !== null;
+    },
+    setKeychain(available: boolean) {
+      keychain = available;
+    },
+  };
+}
