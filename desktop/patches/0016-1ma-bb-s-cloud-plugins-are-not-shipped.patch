index 0000000..8e34efd
--- /dev/null
+++ b/apps/desktop/test/bb-connect-off.test.ts
@@ -0,0 +1,22 @@
+import { describe, expect, it, vi } from "vitest";
+import { forgetBbConnect } from "../src/bb-connect-off.js";
+
+describe("forgetBbConnect", () => {
+  it("deletes the stored machine credential and the account sign-in cookie", async () => {
+    const clear = vi.fn(async () => undefined);
+    const removeCookie = vi.fn(async () => undefined);
+
+    await forgetBbConnect({
+      accountUrl: "https://getbb.app",
+      cookieName: "__Secure-better-auth.session_token",
+      credentialCache: { clear },
+      removeCookie,
+    });
+
+    expect(clear).toHaveBeenCalledOnce();
+    expect(removeCookie).toHaveBeenCalledExactlyOnceWith(
+      "https://getbb.app",
+      "__Secure-better-auth.session_token",
+    );
+  });
+});
