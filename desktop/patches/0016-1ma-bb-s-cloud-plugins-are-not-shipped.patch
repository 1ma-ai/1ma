new file mode 100644
index 0000000..0cf6d78
--- /dev/null
+++ b/packages/domain/src/bb-cloud.ts
@@ -0,0 +1,14 @@
+/**
+ * bb's cloud plugins: they sign in to and send data to bb's own services
+ * (getbb.app). 1ma does not ship them until it runs its own cloud. The server
+ * leaves them out of the plugins it installs and deletes what an older
+ * install stored for them; the desktop app turns bb connect off.
+ */
+export const BB_CLOUD_PLUGIN_NAMES: readonly string[] = [
+  "bb-account",
+  "bb-ai",
+  "connect",
+  "connect-next",
+];
+
+export const BB_CONNECT_SHIPPED = !BB_CLOUD_PLUGIN_NAMES.includes("connect");
