+
+describe("server target store without bb connect", () => {
+  const savedConnect = JSON.stringify({
+    connectServer: {
+      handle: "studio",
+      name: "Studio",
+      url: "https://studio.getbb.app",
+    },
+    connectServerNames: { studio: "Studio Mac" },
+    customServerUrl: "https://lan.example",
+    customServerUrls: ["https://lan.example"],
+    target: "connect",
+  });
+
+  it("forgets a saved connect server on load and writes the file without it", async () => {
+    const { files, fs } = createMemoryFs({ "/tmp/t.json": savedConnect });
+    const store = createServerTargetStore({
+      connect: false,
+      fs,
+      storagePath: "/tmp/t.json",
+    });
+    await store.load();
+
+    expect(store.getTarget()).toEqual({ kind: "builtin" });
+    expect(store.getConnectServer()).toBeNull();
+    expect(store.getConnectServerName("studio")).toBeNull();
+    expect(store.getCustomServerUrls()).toEqual(["https://lan.example"]);
+    const written = files.get("/tmp/t.json") ?? "";
+    expect(written).not.toContain("getbb.app");
+    expect(written).not.toContain("Studio Mac");
+    expect(written).toContain("https://lan.example");
+  });
+
+  it("never chooses or adopts a connect server", async () => {
+    const { fs } = createMemoryFs({
+      "/tmp/t.json": JSON.stringify({
+        customServerUrl: "https://studio.getbb.app",
+        customServerUrls: ["https://studio.getbb.app"],
+        target: "custom",
+      }),
+    });
+    const store = createServerTargetStore({
+      connect: false,
+      fs,
+      storagePath: "/tmp/t.json",
+    });
+    await store.load();
+    const studio = {
+      handle: "studio",
+      name: "Studio",
+      url: "https://studio.getbb.app",
+    };
+
+    expect(await store.adoptConnectServers([studio])).toBe(false);
+    expect(store.getTarget()).toEqual({
+      kind: "custom",
+      url: "https://studio.getbb.app",
+    });
+    await expect(store.setConnectServer(studio)).rejects.toThrow(
+      "bb connect is not part of this app.",
+    );
+    await store.setShowBuiltinServer(false);
+    await store.setCustomServerUrl(null, { availableConnectServers: [studio] });
+    expect(store.getTarget()).toEqual({ kind: "builtin" });
+    expect(await store.setTarget("connect")).toBe(false);
+  });
+});
