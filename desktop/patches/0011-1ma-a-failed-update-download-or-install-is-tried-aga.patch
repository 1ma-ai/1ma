+  it.each(["prepare", "install"] as const)(
+    "tries a version whose %s step failed again six hours later",
+    async (phase) => {
+      const sixHours = 6 * 60 * 60_000;
+      const { applyRequests, launcher } = createScheduledService({
+        autoCheck: true,
+        now: () => new Date(),
+        runningThreads: 0,
+      });
+      launcher.push(
+        failedResult("1.1.0", { finishedAt: new Date().toISOString(), phase }),
+      );
+
+      await vi.advanceTimersByTimeAsync(sixHours - 1_000);
+      expect(applyRequests()).toEqual([]);
+
+      await vi.advanceTimersByTimeAsync(interval);
+      expect(applyRequests()).toEqual([
+        expect.objectContaining({ targetVersion: "1.1.0" }),
+      ]);
+    },
+  );
+
+  it("does not try again a version that failed to start", async () => {
