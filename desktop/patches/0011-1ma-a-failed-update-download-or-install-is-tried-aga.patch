+    launcher.push(
+      failedResult("1.1.0", {
+        finishedAt: new Date().toISOString(),
+        phase: "startup",
+      }),
+    );
+
+    await vi.advanceTimersByTimeAsync(24 * interval);
+    expect(applyRequests()).toEqual([]);
+  });
+
