From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 1ma <hello@1ma.ai>
Date: Sat, 31 Oct 2026 12:07:29 +0100
Subject: [PATCH] 1ma: bb cloud account, cloud AI and bb connect off by default

1ma does not depend on getbb.app: the bb account, bb cloud AI and bb
connect built-in plugins start disabled. Users can still enable them in
Settings.
---
 apps/server/src/services/plugins/builtin-registry.ts | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/apps/server/src/services/plugins/builtin-registry.ts b/apps/server/src/services/plugins/builtin-registry.ts
index 6958dbc..e3ccd23 100644
--- a/apps/server/src/services/plugins/builtin-registry.ts
+++ b/apps/server/src/services/plugins/builtin-registry.ts
@@ -63,17 +63,17 @@ export const BUILTIN_PLUGINS = [
   {
     name: "bb-account",
     pluginId: "bb-account",
-    defaultEnabled: true,
+    defaultEnabled: false,
   },
   {
     name: "bb-ai",
     pluginId: "bb-ai",
-    defaultEnabled: true,
+    defaultEnabled: false,
   },
   {
     name: "connect",
     pluginId: "connect",
-    defaultEnabled: true,
+    defaultEnabled: false,
   },
   {
     name: "connect-next",
