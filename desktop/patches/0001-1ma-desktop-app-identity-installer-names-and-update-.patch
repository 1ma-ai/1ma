+  "appId": "ai.1ma.desktop",
+  "productName": "1ma",
   "artifactName": "${productName}-${version}-${arch}.${ext}",
   "toolsets": {
     "appimage": "1.0.3"
@@ -33,13 +33,13 @@
     {
       "channel": "latest",
       "provider": "generic",
