 import {
   experimental_killPortableProcess,
@@ -54,6 +56,7 @@ interface CodexAppServerRequestArgs<TResult> {
 export interface CodexAppServerConnection {
   request<TResult>(args: CodexAppServerRequestArgs<TResult>): Promise<TResult>;
   kill(): Promise<void>;
+  hasUpdatedExecutable(): boolean;
   readonly exited: boolean;
 }
 
@@ -116,6 +119,18 @@ function isClosedChildStdinError(error: Error): boolean {
   );
 }
 
+function executableIdentity(file: string): string | null {
+  if (process.platform === "win32" || !isAbsolute(file)) return null;
+  try {
+    const stat = statSync(file, { bigint: true, throwIfNoEntry: false });
+    return stat?.isFile()
+      ? `${stat.dev}:${stat.ino}:${stat.mtimeNs}:${stat.size}`
+      : null;
+  } catch {
+    return null;
+  }
+}
+
 export function createCodexAppServerConnection(
   options: CreateCodexAppServerConnectionOptions,
 ): CodexAppServerConnection {
@@ -129,6 +144,7 @@ export function createCodexAppServerConnection(
   experimental_recordProviderChildIo(child, {
     threadId: options.recordThreadId,
   });
+  const launchedExecutable = executableIdentity(child.spawnfile);
 
   const pending = new Map<number, PendingChildRequest>();
   const stderrChunks: string[] = [];
@@ -359,6 +375,14 @@ export function createCodexAppServerConnection(
       return finalized || stdinFailure !== null;
     },
 
+    hasUpdatedExecutable() {
+      if (launchedExecutable === null) return false;
+      const currentExecutable = executableIdentity(child.spawnfile);
+      return (
+        currentExecutable !== null && currentExecutable !== launchedExecutable
+      );
+    },
+
