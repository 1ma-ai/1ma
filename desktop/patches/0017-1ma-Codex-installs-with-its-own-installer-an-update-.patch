+function codexInstallerCommand(
+  platform: NodeJS.Platform = process.platform,
+): ProviderInstallationCommand {
+  if (platform === "win32") {
+    const script = `$env:CODEX_NON_INTERACTIVE=1; irm ${CODEX_POWERSHELL_INSTALL_SCRIPT_URL} | iex`;
+    return {
+      command: "powershell.exe",
+      args: ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", script],
+      displayCommand: script,
+    };
+  }
+  const script = `s=$(curl -fsSL ${CODEX_INSTALL_SCRIPT_URL}) && CODEX_NON_INTERACTIVE=1 eval "$s"`;
+  return { command: "sh", args: ["-c", script], displayCommand: script };
+}
+
+async function codexInstallerMissingTool(): Promise<string | null> {
+  if (process.platform === "win32") return null;
+  return (await resolveExecutablePath("curl")) === null ? "curl" : null;
+}
+
+type CodexUpdateRoute = "standalone" | "npm" | "homebrew";
+
+function pathIsInside(child: string, parent: string): boolean {
+  const relative = path.relative(parent, child);
+  return (
+    relative !== "" && !relative.startsWith("..") && !path.isAbsolute(relative)
+  );
+}
+
+function codexUpdateRoute(args: {
+  platform: NodeJS.Platform;
+  executablePath: string;
+  realExecutablePath: string;
+  standaloneReleases: string | null;
+  installSource: ProviderInstallationStatus["installSource"];
+}): CodexUpdateRoute | null {
+  if (
+    args.standaloneReleases !== null &&
+    pathIsInside(args.realExecutablePath, args.standaloneReleases)
+  ) {
+    return "standalone";
+  }
+  if (args.installSource === "npmGlobal") return "npm";
+  return args.platform === "darwin" &&
+    ["/opt/homebrew/", "/usr/local/"].some((prefix) =>
+      args.executablePath.startsWith(prefix),
+    )
+    ? "homebrew"
+    : null;
+}
+
+async function realPathOrNull(target: string): Promise<string | null> {
+  try {
+    return await fs.realpath(target);
+  } catch {
+    return null;
+  }
+}
+
+async function isWritableDirectory(directory: string): Promise<boolean> {
+  try {
+    await fs.access(directory, fsConstants.W_OK);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+async function npmCanReplaceGlobalPackage(npmBin: string): Promise<boolean> {
+  const modules =
+    process.platform === "win32"
+      ? path.join(npmBin, "node_modules")
+      : path.join(path.dirname(npmBin), "lib", "node_modules");
+  const writable = await Promise.all([
+    isWritableDirectory(npmBin),
+    isWritableDirectory(modules),
+  ]);
+  return writable.every(Boolean);
+}
+
+async function canRunCodexUpdate(args: {
+  executablePath: string | null;
+  installSource: ProviderInstallationStatus["installSource"];
+  npmBin: string | null;
+}): Promise<boolean> {
+  if (args.executablePath === null) return false;
+  const [realExecutablePath, standaloneReleases] = await Promise.all([
+    realPathOrNull(args.executablePath),
+    realPathOrNull(
+      path.join(
+        resolveCodexHome(os.homedir(), process.env),
+        "packages",
+        "standalone",
+        "releases",
+      ),
+    ),
+  ]);
+  const route = codexUpdateRoute({
+    platform: process.platform,
+    executablePath: args.executablePath,
+    realExecutablePath: realExecutablePath ?? args.executablePath,
+    standaloneReleases,
+    installSource: args.installSource,
+  });
+  return route === "npm"
+    ? args.npmBin !== null && (await npmCanReplaceGlobalPackage(args.npmBin))
+    : route !== null;
+}
