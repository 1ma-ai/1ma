+function codexInstallCommand(curl = "curl"): ProviderInstallationCommand {
+  if (process.platform === "win32") {
+    return npmGlobalInstallCommand(CODEX_NPM_PACKAGE);
+  }
+  const download = formatCommand(curl, ["-fsSL", CODEX_INSTALL_SCRIPT_URL]);
+  const script = `s=$(${download}) && CODEX_NON_INTERACTIVE=1 eval "$s"`;
+  return { command: "sh", args: ["-c", script], displayCommand: script };
+}
+
+function setting(value: string | undefined): string | null {
+  return value === undefined || value === "" ? null : value;
+}
+
+function codexInstallProblem(args: {
+  curl: string | null;
+  codexHome: string | null;
+  installDir: string | null;
+  homeDir: string;
+  silentExecutablePath: string | null;
+}): string | null {
+  if (process.platform === "win32") return null;
+  if (args.curl === null) {
+    return "Installing Codex needs curl, which was not found on this host. Install curl and try again.";
+  }
+  if (args.codexHome !== null && !path.isAbsolute(args.codexHome)) {
+    return `CODEX_HOME is the relative path "${args.codexHome}", and Codex's installer would leave a command that does not start. Set CODEX_HOME to an absolute path, or unset it, and try again.`;
+  }
+  const installed = path.join(
+    args.installDir ?? path.join(args.homeDir, ".local", "bin"),
+    "codex",
+  );
+  if (
+    args.silentExecutablePath !== null &&
+    path.resolve(args.silentExecutablePath) !== path.resolve(installed)
+  ) {
+    return `Codex at ${args.silentExecutablePath} did not answer "codex --version", and a new installation would not replace it. If it does not start in a terminal either, remove it and install Codex again.`;
+  }
+  return null;
+}
