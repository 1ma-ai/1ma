diff --git a/apps/server/src/services/threads/thread-create.ts b/apps/server/src/services/threads/thread-create.ts
index 6208083..43faa47 100644
--- a/apps/server/src/services/threads/thread-create.ts
+++ b/apps/server/src/services/threads/thread-create.ts
@@ -608,13 +608,6 @@ export async function createThreadFromRequest(
         parentThreadId: hierarchyParentThreadId,
       })
     : null;
-  if (originKind === null && sourceThreadId !== undefined) {
-    throw new ApiError(
-      400,
-      "invalid_request",
-      "sourceThreadId requires an originKind",
-    );
-  }
   if (originKind === null && requestInput.sourceSeqEnd !== undefined) {
     throw new ApiError(
       400,
@@ -699,7 +692,9 @@ export async function createThreadFromRequest(
     parentThread:
       forkSourceEnvironmentId !== undefined
         ? null
-        : (sourceThread ?? parentThread),
+        : originKind === null
+          ? parentThread
+          : (sourceThread ?? parentThread),
     projectId: requestInput.projectId,
     requestedEnvironment: requestInput.environment,
   });
diff --git a/apps/server/test/threads/thread-create-seed-without-run.test.ts b/apps/server/test/threads/thread-create-seed-without-run.test.ts
index 7b59c11..c76dcd9 100644
--- a/apps/server/test/threads/thread-create-seed-without-run.test.ts
+++ b/apps/server/test/threads/thread-create-seed-without-run.test.ts
@@ -541,6 +541,61 @@ describe("thread creation child-thread boundary validation", () => {
     );
   });
 
+  it("records the source of a continued thread without forking it", async () => {
+    await withChildBoundaryHarness(
+      "continued-thread-source",
+      async ({ harness, hostId, path, projectId, sourceThreadId }) => {
+        seedThreadRuntimeState(harness.deps, {
+          environmentId:
+            getThread(harness.db, sourceThreadId)?.environmentId ?? null,
+          permissionMode: "auto",
+          inputText: "Source question",
+          model: "gpt-5",
+          reasoningLevel: "medium",
+          serviceTier: "default",
+          threadId: sourceThreadId,
+          providerThreadId: "provider-source-session",
+        });
+
+        const continued = await createThreadFromRequest(harness.deps, {
+          environment: {
+            type: "host",
+            hostId,
+            workspace: { type: "unmanaged", path },
+          },
+          input: textInput("Rewritten follow-up"),
+          origin: "app",
+          projectId,
+          providerId: "codex",
+          sourceThreadId,
+          startedOnBehalfOf: null,
+        });
+
+        expect(getThread(harness.db, continued.id)).toMatchObject({
+          sourceThreadId,
+          originKind: null,
+          parentThreadId: null,
+          visibility: "visible",
+        });
+        const queuedStart = await waitForQueuedCommand(
+          harness,
+          ({ command }) =>
+            command.type === "thread.start" &&
+            command.threadId === continued.id,
+        );
+        if (queuedStart.command.type !== "thread.start") {
+          throw new Error("Expected a thread.start command");
+        }
+        expect(queuedStart.command).not.toHaveProperty("fork");
+        expect(
+          listEvents(harness.db, { threadId: continued.id }).filter(
+            (event) => event.type === "client/turn/requested",
+          ),
+        ).toHaveLength(1);
+      },
+    );
+  });
+
   it("rejects startedOnBehalfOf without an originKind", async () => {
     await withChildBoundaryHarness(
       "started-on-behalf-no-origin",
