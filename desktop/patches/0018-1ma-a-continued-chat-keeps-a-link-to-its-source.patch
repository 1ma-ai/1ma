+  it("keeps a hidden continuation when its source is archived", async () => {
+    await withTestHarness(async (harness) => {
+      const { host } = seedHostSession(harness.deps);
+      const { project } = seedProjectWithSource(harness.deps, {
+        hostId: host.id,
+      });
+      const environment = seedEnvironment(harness.deps, {
+        hostId: host.id,
+        projectId: project.id,
+      });
+      const sourceThread = seedThread(harness.deps, {
+        environmentId: environment.id,
+        projectId: project.id,
+      });
+      const continuation = seedThread(harness.deps, {
+        environmentId: environment.id,
+        visibility: "hidden",
+        projectId: project.id,
+        sourceThreadId: sourceThread.id,
+      });
+
+      const response = await harness.app.request(
+        `/api/v1/threads/${sourceThread.id}/archive-all`,
+        { method: "POST" },
+      );
+
+      expect(response.status).toBe(200);
+      expect(
+        threadArchiveAllResponseSchema.parse(await readJson(response))
+          .archivedThreadIds,
+      ).toEqual([sourceThread.id]);
+      expect(getThread(harness.db, continuation.id)).toMatchObject({
+        archivedAt: null,
+        originKind: null,
+        sourceThreadId: sourceThread.id,
+      });
+    });
+  });
+
   it.each([false, true])(
     "archives all descendants once and preserves their parents (archived intermediary: %s)",
     async (archivedIntermediary) => {
