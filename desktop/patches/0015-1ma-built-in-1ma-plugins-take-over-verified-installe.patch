new file mode 100644
index 0000000..3960b82
--- /dev/null
+++ b/apps/server/src/one-ma-rollback.ts
@@ -0,0 +1,52 @@
+// Prepares this data for a 1ma from before the 1ma plugins were built in: with
+// 1ma stopped, removes only the built-in 1ma plugin rows, keeping their
+// settings and data, and says how to install them again
+// (services/plugins/one-ma-rollback.ts). --cancel drops a prepared way back.
+//
+//   node <server package>/server/dist/one-ma-rollback.js --data-dir <dir> [--cancel]
+//
+// The 1ma desktop app runs it with its own runtime: ELECTRON_RUN_AS_NODE=1.
+import { existsSync } from "node:fs";
+import { resolve } from "node:path";
+import { parseArgs } from "node:util";
+import { resolveDataDirDatabasePath } from "@bb/config/runtime";
+import { createConnection } from "@bb/db";
+import { ONE_MA_PLUGINS } from "./services/plugins/builtin-registry.js";
+import { cancelOneMaRollback, prepareOneMaRollback } from "./services/plugins/one-ma-rollback.js";
+
+const { values } = parseArgs({
+  options: { "data-dir": { type: "string" }, cancel: { type: "boolean" } },
+});
+if (values["data-dir"] === undefined) {
+  console.error("usage: one-ma-rollback.js --data-dir <1ma data directory> [--cancel]");
+  process.exit(2);
+}
+const dataDir = resolve(values["data-dir"]);
+if (values.cancel === true) {
+  console.log(
+    (await cancelOneMaRollback(dataDir))
+      ? "cancelled: this version builds the 1ma plugins in again at its next start"
+      : "nothing to cancel",
+  );
+  process.exit(0);
+}
+const databasePath = resolveDataDirDatabasePath({ dataDir });
+if (!existsSync(databasePath)) {
+  console.error(`no 1ma database at ${databasePath}`);
+  process.exit(2);
+}
+const db = createConnection(databasePath);
+try {
+  const lines = await prepareOneMaRollback({
+    db,
+    dataDir,
+    pluginIds: ONE_MA_PLUGINS.map((plugin) => plugin.pluginId),
+  });
+  for (const line of lines) console.log(line);
+  console.log("done: start the older 1ma now, then install the 1ma plugins again");
+} catch (error) {
+  console.error(error instanceof Error ? error.message : String(error));
+  process.exitCode = 1;
+} finally {
+  db.$client.close();
+}
diff --git a/apps/server/src/services/plugins/one-ma-rollback.ts b/apps/server/src/services/plugins/one-ma-rollback.ts
new file mode 100644
index 0000000..983cac4
--- /dev/null
+++ b/apps/server/src/services/plugins/one-ma-rollback.ts
@@ -0,0 +1,235 @@
+import { readFileSync } from "node:fs";
+import { mkdir, readFile, rename, rm, stat, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import Database from "better-sqlite3";
+import { eq } from "drizzle-orm";
+import { drizzle } from "drizzle-orm/better-sqlite3";
+import {
+  claimBbAppRuntimeFile,
+  clearOwnBbAppRuntimeFile,
+  readBbAppRuntimeFile,
+} from "@bb/config/app-runtime-file";
+import { installedPlugins, type DbConnection } from "@bb/db";
+
+// Going back to a 1ma from before the 1ma plugins were built in (patches 0014
+// and 0015). Such a version deletes, with their settings, secrets and
+// schedules, the rows whose source is a built-in it does not know; bb deletes
+// a plugin's data only on removal, and installing a plugin keeps the data
+// stored under its id. So the way back writes a plan, then removes only the
+// built-in 1ma rows, with 1ma stopped. While the plan is there this version
+// leaves the 1ma plugins out instead of building them in again; the older
+// version starts with nothing to delete, and the 1ma plugins installed again
+// there find their data. Seeing such an install, this version drops the plan.
+
+type Action = "install" | "install-and-turn-off" | "leave-out" | "new";
+
+interface PlannedPlugin {
+  id: string;
+  action: Action;
+  // How it was installed before the move, from the database copy.
+  previous: string | null;
+}
+
+interface RollbackPlan {
+  format: 1;
+  createdAt: number;
+  plugins: PlannedPlugin[];
+}
+
+export function oneMaDatabaseCopyPath(dataDir: string): string {
+  return join(dataDir, "backups", "before-1ma-builtins.db");
+}
+
+export function oneMaRollbackPlanPath(dataDir: string): string {
+  return join(dataDir, "backups", "1ma-rollback.json");
+}
+
+async function exists(path: string): Promise<boolean> {
+  return stat(path).then(
+    () => true,
+    () => false,
+  );
+}
+
+async function writeAtomically(path: string, contents: string): Promise<void> {
+  const partial = `${path}.partial`;
+  await writeFile(partial, contents, { mode: 0o600 });
+  await rename(partial, path);
+}
+
+// One copy of the whole database before the first built-in 1ma row, kept as a
+// last resort and as the record of how the plugins were installed before; an
+// existing copy is never replaced.
+export async function saveOneMaDatabaseCopy(db: DbConnection, dataDir: string): Promise<boolean> {
+  const target = oneMaDatabaseCopyPath(dataDir);
+  if (await exists(target)) return false;
+  const partial = `${target}.partial`;
+  await mkdir(join(dataDir, "backups"), { recursive: true });
+  try {
+    await db.$client.backup(partial);
+    await rename(partial, target);
+  } catch (error) {
+    await rm(partial, { force: true });
+    throw error;
+  }
+  return true;
+}
+
+export async function readOneMaRollbackPlan(dataDir: string): Promise<RollbackPlan | null> {
+  try {
+    const plan = JSON.parse(await readFile(oneMaRollbackPlanPath(dataDir), "utf8")) as RollbackPlan;
+    return plan.format === 1 && Array.isArray(plan.plugins) ? plan : null;
+  } catch {
+    return null;
+  }
+}
+
+// Called when this version sees a 1ma plugin installed again by an older one:
+// the way back is done, and the next move to built-ins makes its own copy.
+export async function finishOneMaRollback(dataDir: string, now: number): Promise<void> {
+  await rm(oneMaRollbackPlanPath(dataDir), { force: true });
+  const copy = oneMaDatabaseCopyPath(dataDir);
+  if (await exists(copy)) {
+    await rename(copy, join(dataDir, "backups", `before-1ma-builtins.${now}.db`));
+  }
+}
+
+function previousInstalls(dataDir: string, pluginIds: readonly string[]): Map<string, string> {
+  const found = new Map<string, string>();
+  let sqlite: Database.Database;
+  try {
+    sqlite = new Database(oneMaDatabaseCopyPath(dataDir), { readonly: true, fileMustExist: true });
+  } catch {
+    return found;
+  }
+  const copy = drizzle({ client: sqlite });
+  try {
+    for (const id of pluginIds) {
+      const row = copy.select().from(installedPlugins).where(eq(installedPlugins.id, id)).get();
+      if (row?.sourceKind === "git" && row.sourceGitUrl !== null) {
+        const ref = row.sourceGitResolvedTag ?? row.gitResolvedCommit;
+        found.set(
+          id,
+          `from git ${row.sourceGitUrl}${row.sourceGitSubdirectory === null ? "" : ` (${row.sourceGitSubdirectory})`}${ref === null ? "" : ` at ${ref}`}`,
+        );
+      } else if (row?.sourceKind === "path") {
+        let commit: unknown = null;
+        try {
+          commit = JSON.parse(readFileSync(join(row.rootDir, ".1ma-release.json"), "utf8")).commit;
+        } catch {}
+        found.set(
+          id,
+          typeof commit === "string"
+            ? `from the release folder: node scripts/release-linux.mjs ${commit} --add=${id}`
+            : `from the folder ${row.rootDir}`,
+        );
+      }
+    }
+  } catch {
+    // An unreadable copy only costs the hints.
+  } finally {
+    sqlite.close();
+  }
+  return found;
+}
+
+function describe(plugin: PlannedPlugin): string {
+  const how = plugin.previous === null ? "" : `, ${plugin.previous}`;
+  switch (plugin.action) {
+    case "install":
+      return `${plugin.id}: install it again in the older 1ma${how}; its settings and data are kept`;
+    case "install-and-turn-off":
+      return `${plugin.id}: install it again in the older 1ma${how} and turn it off, as it was; its settings and data are kept`;
+    case "leave-out":
+      return `${plugin.id}: you had removed it, so do not install it again`;
+    case "new":
+      return `${plugin.id}: came with the built-in version; install it in the older 1ma only if you want it; its settings and data are kept`;
+  }
+}
+
+// Takes bb-app's claim on the data folder for its run, so it refuses while
+// 1ma runs; writes the plan before removing the rows in one transaction. A
+// repeated run keeps the earlier decisions. Returns what to tell the owner.
+export async function prepareOneMaRollback(args: {
+  db: DbConnection;
+  dataDir: string;
+  pluginIds: readonly string[];
+  pid?: number;
+  now?: number;
+}): Promise<string[]> {
+  const pid = args.pid ?? process.pid;
+  const now = args.now ?? Date.now();
+  const claimed = await claimBbAppRuntimeFile({
+    dataDir: args.dataDir,
+    entryPath: "one-ma-rollback",
+    pid,
+    serverUrl: "none",
+    startedAt: new Date(now).toISOString(),
+    surface: "1ma-rollback",
+    version: "1",
+  });
+  if (!claimed) {
+    const running = await readBbAppRuntimeFile(args.dataDir);
+    throw new Error(
+      `1ma is running on this data (process ${String(running?.pid)}); stop it and run this again`,
+    );
+  }
+  try {
+    const earlier = new Map(
+      ((await readOneMaRollbackPlan(args.dataDir))?.plugins ?? []).map((plugin) => [plugin.id, plugin]),
+    );
+    const previous = previousInstalls(args.dataDir, args.pluginIds);
+    const current = (id: string) =>
+      args.db.select().from(installedPlugins).where(eq(installedPlugins.id, id)).get();
+    const plugins: PlannedPlugin[] = [];
+    const notes: string[] = [];
+    for (const id of args.pluginIds) {
+      const row = current(id);
+      if (row !== undefined && row.sourceKind !== "builtin") {
+        notes.push(`${id}: installed from ${row.source}, left as it is`);
+        continue;
+      }
+      const before = earlier.get(id);
+      if (before !== undefined) {
+        plugins.push(before);
+        continue;
+      }
+      if (row === undefined) continue;
+      plugins.push({
+        id,
+        action:
+          row.removedAt !== null
+            ? "leave-out"
+            : !previous.has(id)
+              ? "new"
+              : row.enabled
+                ? "install"
+                : "install-and-turn-off",
+        previous: previous.get(id) ?? null,
+      });
+    }
+    await mkdir(join(args.dataDir, "backups"), { recursive: true });
+    const plan: RollbackPlan = { format: 1, createdAt: now, plugins };
+    await writeAtomically(oneMaRollbackPlanPath(args.dataDir), `${JSON.stringify(plan, null, 2)}\n`);
+    args.db.transaction(
+      (tx) => {
+        for (const plugin of plugins) {
+          const row = tx.select().from(installedPlugins).where(eq(installedPlugins.id, plugin.id)).get();
+          if (row?.sourceKind === "builtin") {
+            tx.delete(installedPlugins).where(eq(installedPlugins.id, plugin.id)).run();
+          }
+        }
+      },
+      { behavior: "exclusive" },
+    );
+    return [...plugins.map(describe), ...notes];
+  } finally {
+    await clearOwnBbAppRuntimeFile({ dataDir: args.dataDir, pid });
+  }
+}
+
+export async function cancelOneMaRollback(dataDir: string): Promise<boolean> {
+  if (!(await exists(oneMaRollbackPlanPath(dataDir)))) return false;
+  await rm(oneMaRollbackPlanPath(dataDir), { force: true });
+  return true;
+}
