@@ -0,0 +1,38 @@
+// Puts the 1ma plugins back the way they were installed before they were
+// built in, so that an older 1ma can start on this data. With 1ma stopped:
+//
+//   node <server package>/server/dist/one-ma-rollback.js --data-dir <dir>
+//
+// The 1ma desktop app runs it with its own runtime: ELECTRON_RUN_AS_NODE=1.
+import { existsSync } from "node:fs";
+import { resolve } from "node:path";
+import { parseArgs } from "node:util";
+import { resolveDataDirDatabasePath } from "@bb/config/runtime";
+import { createConnection } from "@bb/db";
+import { restoreOneMaRollbackSet } from "./services/plugins/one-ma-rollback.js";
+
+const { values } = parseArgs({ options: { "data-dir": { type: "string" } } });
+const dataDir = values["data-dir"];
+if (dataDir === undefined) {
+  console.error("usage: one-ma-rollback.js --data-dir <1ma data directory>");
+  process.exit(2);
+}
+const databasePath = resolveDataDirDatabasePath({ dataDir: resolve(dataDir) });
+if (!existsSync(databasePath)) {
+  console.error(`no 1ma database at ${databasePath}`);
+  process.exit(2);
+}
+const db = createConnection(databasePath);
+try {
+  await restoreOneMaRollbackSet({
+    db,
+    dataDir: resolve(dataDir),
+    log: (line) => console.log(line),
+  });
+  console.log("done: the older 1ma can be started now");
+} catch (error) {
+  console.error(error instanceof Error ? error.message : String(error));
+  process.exitCode = 1;
+} finally {
+  db.$client.close();
+}
diff --git a/apps/server/src/services/plugins/one-ma-rollback.ts b/apps/server/src/services/plugins/one-ma-rollback.ts
new file mode 100644
index 0000000..bc4be82
--- /dev/null
+++ b/apps/server/src/services/plugins/one-ma-rollback.ts
@@ -0,0 +1,172 @@
+import { cp, mkdir, readFile, rename, rm, stat, writeFile } from "node:fs/promises";
+import { join, relative, resolve, sep } from "node:path";
+import { eq } from "drizzle-orm";
+import { installedPlugins, pluginArtifacts, type DbConnection } from "@bb/db";
+
+// The 1ma plugins' installs from before they were built in (patches 0014 and
+// 0015), saved once so that an older 1ma can run on the same data again. Such
+// a version deletes, with their settings, the rows whose source is a built-in
+// it does not know, and bb's artifact GC removes a git checkout once no row
+// points at it. Restoring puts back only these rows and checkouts; everything
+// else in the database stays as it is.
+export const ONE_MA_ROLLBACK_DIRECTORY = "before-1ma-builtins";
+
+type PluginRegistration = typeof installedPlugins.$inferSelect;
+type PluginArtifact = typeof pluginArtifacts.$inferSelect;
+
+interface SavedPlugin {
+  id: string;
+  registration: PluginRegistration;
+  artifact: PluginArtifact | null;
+  files: { original: string; copy: string }[];
+}
+
+interface RollbackManifest {
+  format: 1;
+  appVersion: string;
+  createdAt: number;
+  plugins: SavedPlugin[];
+}
+
+export function oneMaRollbackDirectory(dataDir: string): string {
+  return join(dataDir, "backups", ONE_MA_ROLLBACK_DIRECTORY);
+}
+
+async function exists(path: string): Promise<boolean> {
+  return stat(path).then(
+    () => true,
+    () => false,
+  );
+}
+
+function isInside(parent: string, child: string): boolean {
+  const fromParent = relative(resolve(parent), resolve(child));
+  return fromParent !== "" && fromParent !== ".." && !fromParent.startsWith(`..${sep}`);
+}
+
+// Does nothing when the set exists: it describes the state before the very
+// first built-in row, and a later pass must not replace it with a mixed one.
+export async function saveOneMaRollbackSet(args: {
+  db: DbConnection;
+  dataDir: string;
+  appVersion: string;
+  pluginIds: readonly string[];
+  now: number;
+}): Promise<boolean> {
+  const target = oneMaRollbackDirectory(args.dataDir);
+  if (await exists(target)) return false;
+  const staging = `${target}.partial`;
+  await rm(staging, { recursive: true, force: true });
+  await mkdir(join(staging, "files"), { recursive: true });
+  try {
+    await args.db.$client.backup(join(staging, "bb.db"));
+    const plugins: SavedPlugin[] = [];
+    const copies = new Map<string, string>();
+    for (const id of args.pluginIds) {
+      const registration = args.db
+        .select()
+        .from(installedPlugins)
+        .where(eq(installedPlugins.id, id))
+        .get();
+      if (registration === undefined || registration.sourceKind === "builtin") continue;
+      const artifact =
+        registration.activeArtifactId === null
+          ? null
+          : (args.db
+              .select()
+              .from(pluginArtifacts)
+              .where(eq(pluginArtifacts.id, registration.activeArtifactId))
+              .get() ?? null);
+      const files: SavedPlugin["files"] = [];
+      const root = artifact === null ? null : (artifact.gitCheckoutRoot ?? artifact.path);
+      if (root !== null && isInside(args.dataDir, root)) {
+        let copy = copies.get(root);
+        if (copy === undefined) {
+          copy = join("files", String(copies.size));
+          await cp(root, join(staging, copy), { recursive: true, verbatimSymlinks: true });
+          copies.set(root, copy);
+        }
+        files.push({ original: root, copy });
+      }
+      plugins.push({ id, registration, artifact, files });
+    }
+    const manifest: RollbackManifest = {
+      format: 1,
+      appVersion: args.appVersion,
+      createdAt: args.now,
+      plugins,
+    };
+    await writeFile(join(staging, "plugins.json"), `${JSON.stringify(manifest, null, 2)}\n`, {
+      mode: 0o600,
+    });
+    await rename(staging, target);
+    return true;
+  } catch (error) {
+    await rm(staging, { recursive: true, force: true });
+    throw error;
+  }
+}
+
+// Run with 1ma stopped, before an older version starts on this data. A plugin
+// that is no longer built in is left alone; one that is gone means an older
+// version already ran, and only the whole database copy can help.
+export async function restoreOneMaRollbackSet(args: {
+  db: DbConnection;
+  dataDir: string;
+  log: (line: string) => void;
+}): Promise<void> {
+  const directory = oneMaRollbackDirectory(args.dataDir);
+  const manifestPath = join(directory, "plugins.json");
+  if (!(await exists(manifestPath))) {
+    throw new Error(`nothing to restore: ${manifestPath} does not exist`);
+  }
+  const manifest = JSON.parse(await readFile(manifestPath, "utf8")) as RollbackManifest;
+  if (manifest.format !== 1) {
+    throw new Error(`${manifestPath} has format ${String(manifest.format)}, expected 1`);
+  }
+  const pending: SavedPlugin[] = [];
+  for (const plugin of manifest.plugins) {
+    const current = args.db
+      .select()
+      .from(installedPlugins)
+      .where(eq(installedPlugins.id, plugin.id))
+      .get();
+    if (current === undefined) {
+      throw new Error(
+        `${plugin.id} is no longer installed, so an older 1ma has probably run on this data already; with 1ma stopped, put ${join(directory, "bb.db")} in place of the database instead`,
+      );
+    }
+    if (current.sourceKind !== "builtin") {
+      args.log(`${plugin.id}: installed from ${current.source}, left as it is`);
+      continue;
+    }
+    pending.push(plugin);
+  }
+  for (const plugin of pending) {
+    for (const file of plugin.files) {
+      if (!(await exists(file.original))) {
+        await cp(join(directory, file.copy), file.original, {
+          recursive: true,
+          verbatimSymlinks: true,
+        });
+      }
+    }
+  }
+  args.db.transaction((tx) => {
+    for (const plugin of pending) {
+      if (plugin.artifact !== null) {
+        tx.insert(pluginArtifacts)
+          .values(plugin.artifact)
+          .onConflictDoUpdate({ target: pluginArtifacts.id, set: plugin.artifact })
+          .run();
+      }
+      tx.insert(installedPlugins)
+        .values(plugin.registration)
+        .onConflictDoUpdate({ target: installedPlugins.id, set: plugin.registration })
+        .run();
+    }
+  });
+  for (const plugin of pending) {
+    args.log(`${plugin.id}: installed from ${plugin.registration.source} again`);
+  }
+}
