+        dataDir: deps.dataDir,
+        appVersion: deps.appVersion,
+        pluginIds: ids,
+        now: Date.now(),
+      });
+      logger.info(
+        `saved the 1ma plugins' state to ${oneMaRollbackDirectory(deps.dataDir)} before they are built in`,
+      );
+      return null;
+    } catch (error) {
+      return `could not save the state from before first: ${
+        error instanceof Error ? error.message : String(error)
+      }`;
+    }
+  }
