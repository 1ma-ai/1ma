@@ -0,0 +1,309 @@
+import { createHash } from "node:crypto";
+import { cpSync, lstatSync, readdirSync, readFileSync, readlinkSync, rmSync } from "node:fs";
+import { cp, mkdir, readFile, rename, rm, stat, writeFile } from "node:fs/promises";
+import { isAbsolute, join, relative } from "node:path";
+import { eq } from "drizzle-orm";
+import {
+  claimBbAppRuntimeFile,
+  clearOwnBbAppRuntimeFile,
+  readBbAppRuntimeFile,
+} from "@bb/config/app-runtime-file";
+import { installedPlugins, pluginArtifacts, type DbConnection } from "@bb/db";
+
+// The 1ma plugins' state from before they were built in (patches 0014 and
+// 0015), saved once so that an older 1ma can run on the same data again. Such
+// a version deletes, with their settings, the rows whose source is a built-in
+// it does not know, bb's artifact GC removes a git checkout once no row points
+// at it, and the Linux release folder moves on to later commits. Restoring
+// puts back only these rows and file trees; everything else stays.
+export const ONE_MA_ROLLBACK_DIRECTORY = "before-1ma-builtins";
+const FORMAT = 2;
+
+type PluginRegistration = typeof installedPlugins.$inferSelect;
+type PluginArtifact = typeof pluginArtifacts.$inferSelect;
+
+interface SavedTree {
+  kind: "artifact" | "path";
+  original: string;
+  copy: string;
+  sha256: string;
+}
+
+type SavedPlugin =
+  | { id: string; state: "absent" }
+  | {
+      id: string;
+      state: "installed";
+      registration: PluginRegistration;
+      artifact: PluginArtifact | null;
+      tree: SavedTree | null;
+    };
+
+interface RollbackManifest {
+  format: typeof FORMAT;
+  appVersion: string;
+  createdAt: number;
+  plugins: SavedPlugin[];
+}
+
+export function oneMaRollbackDirectory(dataDir: string): string {
+  return join(dataDir, "backups", ONE_MA_ROLLBACK_DIRECTORY);
+}
+
+export function oneMaRestoredPluginDirectory(dataDir: string, pluginId: string): string {
+  return join(dataDir, "plugins", "1ma-rollback", pluginId);
+}
+
+async function exists(path: string): Promise<boolean> {
+  return stat(path).then(
+    () => true,
+    () => false,
+  );
+}
+
+// Paths, file contents and link targets, in a fixed order.
+export function treeSha256(root: string): string {
+  const hash = createHash("sha256");
+  const walk = (relative: string): void => {
+    const path = join(root, relative);
+    const entry = lstatSync(path);
+    if (entry.isSymbolicLink()) {
+      hash.update(`link\0${relative}\0${readlinkSync(path)}\0`);
+    } else if (entry.isDirectory()) {
+      hash.update(`dir\0${relative}\0`);
+      for (const name of readdirSync(path).sort()) walk(join(relative, name));
+    } else {
+      hash.update(`file\0${relative}\0`);
+      hash.update(readFileSync(path));
+      hash.update("\0");
+    }
+  };
+  walk("");
+  return hash.digest("hex");
+}
+
+// The saved state, or null when there is none that can be used.
+export async function readOneMaRollbackSet(dataDir: string): Promise<RollbackManifest | null> {
+  try {
+    const manifest = JSON.parse(
+      await readFile(join(oneMaRollbackDirectory(dataDir), "plugins.json"), "utf8"),
+    ) as RollbackManifest;
+    return manifest.format === FORMAT && Array.isArray(manifest.plugins) ? manifest : null;
+  } catch {
+    return null;
+  }
+}
+
+// Writes the set under a temporary name and renames it into place, so it
+// either exists whole or not at all; refuses when anything is in the way.
+export async function saveOneMaRollbackSet(args: {
+  db: DbConnection;
+  dataDir: string;
+  appVersion: string;
+  pluginIds: readonly string[];
+  now: number;
+}): Promise<void> {
+  const target = oneMaRollbackDirectory(args.dataDir);
+  if (await exists(target)) {
+    throw new Error(`${target} exists but holds no usable saved state; move it aside`);
+  }
+  const staging = `${target}.partial`;
+  await rm(staging, { recursive: true, force: true });
+  await mkdir(join(staging, "files"), { recursive: true });
+  try {
+    await args.db.$client.backup(join(staging, "bb.db"));
+    const plugins: SavedPlugin[] = [];
+    const copies = new Map<string, SavedTree>();
+    for (const id of args.pluginIds) {
+      const registration = args.db
+        .select()
+        .from(installedPlugins)
+        .where(eq(installedPlugins.id, id))
+        .get();
+      if (registration === undefined) {
+        plugins.push({ id, state: "absent" });
+        continue;
+      }
+      if (registration.sourceKind === "builtin") {
+        throw new Error(`${id} is built in already`);
+      }
+      const artifact =
+        registration.activeArtifactId === null
+          ? null
+          : (args.db
+              .select()
+              .from(pluginArtifacts)
+              .where(eq(pluginArtifacts.id, registration.activeArtifactId))
+              .get() ?? null);
+      const source: Pick<SavedTree, "kind" | "original"> | null =
+        artifact !== null
+          ? { kind: "artifact", original: artifact.gitCheckoutRoot ?? artifact.path }
+          : registration.sourceKind === "path"
+            ? { kind: "path", original: registration.rootDir }
+            : null;
+      let tree: SavedTree | null = null;
+      if (source !== null) {
+        tree = copies.get(source.original) ?? null;
+        if (tree === null) {
+          const copy = join("files", String(copies.size));
+          await cp(source.original, join(staging, copy), {
+            recursive: true,
+            verbatimSymlinks: true,
+          });
+          tree = { ...source, copy, sha256: treeSha256(join(staging, copy)) };
+          copies.set(source.original, tree);
+        }
+      }
+      plugins.push({ id, state: "installed", registration, artifact, tree });
+    }
+    const manifest: RollbackManifest = {
+      format: FORMAT,
+      appVersion: args.appVersion,
+      createdAt: args.now,
+      plugins,
+    };
+    await writeFile(join(staging, "plugins.json"), `${JSON.stringify(manifest, null, 2)}\n`, {
+      mode: 0o600,
+    });
+    await rename(staging, target);
+  } catch (error) {
+    await rm(staging, { recursive: true, force: true });
+    throw error;
+  }
+}
+
+// Run with 1ma stopped, before an older version starts on this data. It takes
+// bb-app's own claim on the data folder for its whole run, so it refuses while
+// 1ma runs and 1ma cannot take the folder meanwhile; everything is checked
+// before anything changes. A plugin that is no longer built in is left alone;
+// one that is gone means an older version already ran, and only the whole
+// database copy can help. Afterwards the set is renamed, so a later move to
+// built-in plugins saves the state of that time.
+export async function restoreOneMaRollbackSet(args: {
+  db: DbConnection;
+  dataDir: string;
+  log: (line: string) => void;
+  pid?: number;
+  now?: number;
+}): Promise<void> {
+  const pid = args.pid ?? process.pid;
+  const now = args.now ?? Date.now();
+  const claimed = await claimBbAppRuntimeFile({
+    dataDir: args.dataDir,
+    entryPath: "one-ma-rollback",
+    pid,
+    serverUrl: "none",
+    startedAt: new Date(now).toISOString(),
+    surface: "1ma-rollback",
+    version: "1",
+  });
+  if (!claimed) {
+    const running = await readBbAppRuntimeFile(args.dataDir);
+    throw new Error(
+      `1ma is running on this data (process ${String(running?.pid)}); stop it and run this again`,
+    );
+  }
+  try {
+    await restoreClaimed({ ...args, now });
+  } finally {
+    await clearOwnBbAppRuntimeFile({ dataDir: args.dataDir, pid });
+  }
+}
+
+async function restoreClaimed(args: {
+  db: DbConnection;
+  dataDir: string;
+  log: (line: string) => void;
+  now: number;
+}): Promise<void> {
+  const directory = oneMaRollbackDirectory(args.dataDir);
+  const manifest = await readOneMaRollbackSet(args.dataDir);
+  if (manifest === null) {
+    throw new Error(`nothing to restore: ${join(directory, "plugins.json")} is missing or unreadable`);
+  }
+  const cache = join(args.dataDir, "plugins", "cache");
+  for (const plugin of manifest.plugins) {
+    if (plugin.state !== "installed" || plugin.tree === null) continue;
+    const inCache = relative(cache, plugin.tree.original);
+    if (
+      plugin.tree.kind === "artifact" &&
+      (inCache === "" || inCache.startsWith("..") || isAbsolute(inCache))
+    ) {
+      throw new Error(`${plugin.id}'s saved checkout ${plugin.tree.original} is outside ${cache}; nothing changed`);
+    }
+    if (treeSha256(join(directory, plugin.tree.copy)) !== plugin.tree.sha256) {
+      throw new Error(`the saved files of ${plugin.id} in ${directory} are damaged; nothing changed`);
+    }
+  }
+  const current = (id: string) =>
+    args.db.select().from(installedPlugins).where(eq(installedPlugins.id, id)).get();
+  const restore: Extract<SavedPlugin, { state: "installed" }>[] = [];
+  const drop: string[] = [];
+  for (const plugin of manifest.plugins) {
+    const row = current(plugin.id);
+    if (plugin.state === "absent") {
+      if (row?.sourceKind === "builtin") drop.push(plugin.id);
+      continue;
+    }
+    if (row === undefined) {
+      throw new Error(
+        `${plugin.id} is no longer installed, so an older 1ma has probably run on this data already; with 1ma stopped, put ${join(directory, "bb.db")} in place of the database instead`,
+      );
+    }
+    if (row.sourceKind !== "builtin") {
+      args.log(`${plugin.id}: installed from ${row.source}, left as it is`);
+      continue;
+    }
+    restore.push(plugin);
+  }
+  const lines: string[] = [];
+  args.db.transaction(
+    (tx) => {
+      const placed = new Set<string>();
+      for (const plugin of restore) {
+        let registration = plugin.registration;
+        const tree = plugin.tree;
+        if (tree !== null) {
+          const destination =
+            tree.kind === "artifact"
+              ? tree.original
+              : oneMaRestoredPluginDirectory(args.dataDir, plugin.id);
+          if (!placed.has(destination)) {
+            rmSync(destination, { recursive: true, force: true });
+            cpSync(join(directory, tree.copy), destination, {
+              recursive: true,
+              verbatimSymlinks: true,
+            });
+            placed.add(destination);
+          }
+          if (tree.kind === "path") {
+            registration = {
+              ...registration,
+              source: `path:${destination}`,
+              sourcePath: destination,
+              rootDir: destination,
+            };
+          }
+        }
+        if (plugin.artifact !== null) {
+          tx.insert(pluginArtifacts)
+            .values(plugin.artifact)
+            .onConflictDoUpdate({ target: pluginArtifacts.id, set: plugin.artifact })
+            .run();
+        }
+        tx.insert(installedPlugins)
+          .values(registration)
+          .onConflictDoUpdate({ target: installedPlugins.id, set: registration })
+          .run();
+        lines.push(`${plugin.id}: installed from ${registration.source} again`);
+      }
+      for (const id of drop) {
+        tx.delete(installedPlugins).where(eq(installedPlugins.id, id)).run();
+        lines.push(`${id}: was not installed before; removed, its settings and data kept`);
+      }
+    },
+    { behavior: "exclusive" },
+  );
+  for (const line of lines) args.log(line);
+  await rename(directory, `${directory}.restored-${args.now}`);
+}
