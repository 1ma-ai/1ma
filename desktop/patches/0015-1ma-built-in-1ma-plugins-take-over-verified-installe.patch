+  const oneMaPluginNames = new Set(ONE_MA_PLUGINS.map((plugin) => plugin.name));
+
+  // The forms bb's git sources accept (install-sources.ts): an http(s) URL or
+  // host/path; compared by host and repository path.
+  function isOneMaRepository(url: string): boolean {
+    let parsed: URL;
+    try {
+      parsed = new URL(/^[a-z][a-z0-9+.-]*:\/\//iu.test(url) ? url : `https://${url}`);
+    } catch {
+      return false;
+    }
+    const repository = parsed.pathname
+      .replace(/^\/+|\/+$/gu, "")
+      .replace(/\.git$/u, "")
+      .toLowerCase();
+    return (
+      (parsed.protocol === "https:" || parsed.protocol === "http:") &&
+      parsed.hostname.toLowerCase() === "github.com" &&
+      parsed.port === "" &&
+      repository === "1ma-ai/1ma"
+    );
+  }
+
+  async function oneMaTakeoverProblem(
+    existing: InstalledPluginRow,
+    name: string,
+    builtinVersion: string,
+  ): Promise<string | null> {
+    if (existing.sourceKind === "git") {
+      if (
+        existing.sourceGitUrl === null ||
+        !isOneMaRepository(existing.sourceGitUrl) ||
+        existing.sourceGitSubdirectory !== `plugins/${name}`
+      ) {
+        return `it is installed from ${existing.source}, not from 1ma's repository`;
+      }
+    } else if (existing.sourceKind === "path") {
+      let repository: unknown = null;
+      try {
+        repository = JSON.parse(
+          await readFile(join(existing.rootDir, ".1ma-release.json"), "utf8"),
+        ).repository;
+      } catch {}
+      if (
+        typeof repository !== "string" ||
+        !isOneMaRepository(repository)
+      ) {
+        return `${existing.rootDir} is not a 1ma release install (no .1ma-release.json)`;
+      }
+    } else {
+      return `it is installed from ${existing.source}`;
+    }
+    const installed = semver.valid(existing.version);
+    const shipped = semver.valid(builtinVersion);
+    if (installed === null || shipped === null) {
+      return `its version ${existing.version} cannot be compared with ${builtinVersion}`;
+    }
+    if (semver.gt(installed, shipped)) {
+      return `the installed ${existing.version} is newer than the built-in ${builtinVersion}`;
+    }
+    return null;
+  }
+
+  // Before the first built-in 1ma row is written, the database is copied once
+  // as a last resort (one-ma-rollback.ts has the way back). Returns why the
+  // 1ma row has to wait, or null; a copy that still works stays meanwhile.
+  async function oneMaDatabaseCopyProblem(): Promise<string | null> {
+    const ids = ONE_MA_PLUGINS.map((plugin) => plugin.pluginId);
+    if (ids.some((id) => getInstalledPluginRegistration(deps.db, id)?.sourceKind === "builtin")) {
+      return null;
+    }
+    try {
+      if (await saveOneMaDatabaseCopy(deps.db, deps.dataDir)) {
+        logger.info(
+          `copied the database to ${oneMaDatabaseCopyPath(deps.dataDir)} before the 1ma plugins are built in`,
+        );
+      }
+      return null;
+    } catch (error) {
+      return `could not copy the database first: ${
+        error instanceof Error ? error.message : String(error)
+      }`;
+    }
+  }
+
+  // While a prepared way back to an older 1ma is pending, the 1ma plugins stay
+  // out, so the older version still finds nothing to delete. A 1ma plugin
+  // installed again (by that version) means it has run: the plan is done.
+  // Returns why the 1ma plugins stay out, or null.
+  async function oneMaRollbackHold(): Promise<string | null> {
+    if ((await readOneMaRollbackPlan(deps.dataDir)) === null) return null;
+    const ids = ONE_MA_PLUGINS.map((plugin) => plugin.pluginId);
+    if (
+      ids.some((id) => {
+        const row = getInstalledPluginRegistration(deps.db, id);
+        return row !== undefined && row.sourceKind !== "builtin";
+      })
+    ) {
+      await finishOneMaRollback(deps.dataDir, Date.now());
+      logger.info("a 1ma plugin was installed again after going back; the 1ma plugins are built in again");
+      return null;
+    }
+    return `the way back to an older 1ma is prepared (${oneMaRollbackPlanPath(deps.dataDir)}); start the older 1ma, or run one-ma-rollback.js --cancel to keep this version`;
