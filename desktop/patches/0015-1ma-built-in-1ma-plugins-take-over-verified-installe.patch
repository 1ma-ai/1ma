@@ -0,0 +1,75 @@
+// Prepares this data for a 1ma from before the 1ma plugins were built in: with
+// 1ma stopped, removes only the built-in 1ma plugin rows, keeping their
+// settings and data, and says how to install them again
+// (services/plugins/one-ma-rollback.ts). --resume ends a prepared way back:
+// to stay on this version, or after the older one installed them again.
+//
+//   node <server package>/server/dist/one-ma-rollback.js --data-dir <dir> [--resume [--replace-other-copies]]
+//
+// The 1ma desktop app runs it with its own runtime: ELECTRON_RUN_AS_NODE=1.
+import { existsSync, readFileSync } from "node:fs";
+import { join, resolve } from "node:path";
+import { parseArgs } from "node:util";
+import { resolveDataDirDatabasePath } from "@bb/config/runtime";
+import { createConnection } from "@bb/db";
+import {
+  ONE_MA_PLUGINS,
+  resolveBuiltinPluginRootPath,
+} from "./services/plugins/builtin-registry.js";
+import { prepareOneMaRollback, resumeOneMa } from "./services/plugins/one-ma-rollback.js";
+
+const { values } = parseArgs({
+  options: {
+    "data-dir": { type: "string" },
+    resume: { type: "boolean" },
+    "replace-other-copies": { type: "boolean" },
+  },
+});
+if (values["data-dir"] === undefined) {
+  console.error("usage: one-ma-rollback.js --data-dir <1ma data directory> [--resume]");
+  process.exit(2);
+}
+const dataDir = resolve(values["data-dir"]);
+const databasePath = resolveDataDirDatabasePath({ dataDir });
+if (!existsSync(databasePath)) {
+  console.error(`no 1ma database at ${databasePath}`);
+  process.exit(2);
+}
+const db = createConnection(databasePath);
+try {
+  if (values.resume === true) {
+    const builtinVersions: Record<string, string> = {};
+    for (const plugin of ONE_MA_PLUGINS) {
+      try {
+        builtinVersions[plugin.pluginId] = JSON.parse(
+          readFileSync(join(resolveBuiltinPluginRootPath(plugin.name), "package.json"), "utf8"),
+        ).version;
+      } catch {}
+    }
+    const result = await resumeOneMa({
+      db,
+      dataDir,
+      builtinVersions,
+      replaceOtherCopies: values["replace-other-copies"] === true,
+    });
+    for (const line of result.lines) console.log(line);
+    if (result.finished) {
+      console.log("done: this version builds the 1ma plugins in at its next start");
+    } else {
+      process.exitCode = 1;
+    }
+  } else {
+    const lines = await prepareOneMaRollback({
+      db,
+      dataDir,
+      pluginIds: ONE_MA_PLUGINS.map((plugin) => plugin.pluginId),
+    });
+    for (const line of lines) console.log(line);
+    console.log("done: start the older 1ma now, then install the 1ma plugins again");
+  }
+} catch (error) {
+  console.error(error instanceof Error ? error.message : String(error));
+  process.exitCode = 1;
+} finally {
+  db.$client.close();
+}
diff --git a/apps/server/src/services/plugins/one-ma-rollback.ts b/apps/server/src/services/plugins/one-ma-rollback.ts
new file mode 100644
index 0000000..2fb6922
--- /dev/null
+++ b/apps/server/src/services/plugins/one-ma-rollback.ts
@@ -0,0 +1,374 @@
+import { readFileSync } from "node:fs";
+import { mkdir, rename, rm, stat } from "node:fs/promises";
+import { join } from "node:path";
+import { eq } from "drizzle-orm";
+import semver from "semver";
+import {
+  claimBbAppRuntimeFile,
+  clearOwnBbAppRuntimeFile,
+  readBbAppRuntimeFile,
+} from "@bb/config/app-runtime-file";
+import {
+  appSettingsValues,
+  installedPlugins,
+  type DbConnection,
+  type DbQueryConnection,
+} from "@bb/db";
+
+// Going back to a 1ma from before the 1ma plugins were built in (patches 0014
+// and 0015). Such a version deletes, with their settings, secrets and
+// schedules, the rows whose source is a built-in it does not know; bb deletes
+// a plugin's data only on removal, and installing a plugin keeps the data
+// stored under its id. So the way back, with 1ma stopped, moves the built-in
+// 1ma rows into a pending rollback in the same transaction that removes them.
+// While it is pending, every built-in 1ma row is written only by a
+// transaction that first finds it absent, so no start of this version can hand
+// the older one a row to delete. The older version starts with nothing to
+// delete, and the 1ma plugins installed again there find their data.
+// --resume ends it: removed rows come back exactly as they were, unless the
+// older version installed that plugin again, which is then taken over anew.
+// The state lives in app_settings_values, which both versions read only by
+// their own keys.
+
+const PREVIOUS_KEY = "1ma.previousInstalls";
+const ROLLBACK_KEY = "1ma.rollback";
+
+type PluginRow = typeof installedPlugins.$inferSelect;
+// How each 1ma plugin was installed before the first move; null: it was not.
+type PreviousInstalls = Record<string, string | null>;
+interface PendingRollback {
+  createdAt: number;
+  rows: Record<string, PluginRow>;
+}
+
+function readValue<T>(db: DbQueryConnection, key: string): T | null {
+  const row = db
+    .select({ value: appSettingsValues.value })
+    .from(appSettingsValues)
+    .where(eq(appSettingsValues.key, key))
+    .get();
+  if (row === undefined) return null;
+  try {
+    return JSON.parse(row.value) as T;
+  } catch {
+    return null;
+  }
+}
+
+function writeValue(db: DbQueryConnection, key: string, value: unknown): void {
+  const text = JSON.stringify(value);
+  const updatedAt = Date.now();
+  db.insert(appSettingsValues)
+    .values({ key, value: text, updatedAt })
+    .onConflictDoUpdate({ target: appSettingsValues.key, set: { value: text, updatedAt } })
+    .run();
+}
+
+function deleteValue(db: DbQueryConnection, key: string): void {
+  db.delete(appSettingsValues).where(eq(appSettingsValues.key, key)).run();
+}
+
+export function oneMaRollbackPending(db: DbQueryConnection): boolean {
+  return readValue<PendingRollback>(db, ROLLBACK_KEY) !== null;
+}
+
+export function oneMaDatabaseCopyPath(dataDir: string): string {
+  return join(dataDir, "backups", "before-1ma-builtins.db");
+}
+
+async function exists(path: string): Promise<boolean> {
+  return stat(path).then(
+    () => true,
+    () => false,
+  );
+}
+
+function describeInstall(row: PluginRow): string {
+  if (row.sourceKind === "git" && row.sourceGitUrl !== null) {
+    const ref = row.sourceGitResolvedTag ?? row.gitResolvedCommit;
+    const subdirectory = row.sourceGitSubdirectory === null ? "" : ` (${row.sourceGitSubdirectory})`;
+    return `from git ${row.sourceGitUrl}${subdirectory}${ref === null ? "" : ` at ${ref}`}`;
+  }
+  if (row.sourceKind === "path") {
+    let commit: unknown = null;
+    try {
+      commit = JSON.parse(readFileSync(join(row.rootDir, ".1ma-release.json"), "utf8")).commit;
+    } catch {}
+    return typeof commit === "string"
+      ? `from the release folder: node scripts/release-linux.mjs ${commit} --add=${row.id}`
+      : `from the folder ${row.rootDir}`;
+  }
+  return `from ${row.source}`;
+}
+
+// The forms bb's git sources accept (install-sources.ts): an http(s) URL or
+// host/path; compared by host and repository path.
+function isOneMaRepository(url: string): boolean {
+  let parsed: URL;
+  try {
+    parsed = new URL(/^[a-z][a-z0-9+.-]*:\/\//iu.test(url) ? url : `https://${url}`);
+  } catch {
+    return false;
+  }
+  const repository = parsed.pathname
+    .replace(/^\/+|\/+$/gu, "")
+    .replace(/\.git$/u, "")
+    .toLowerCase();
+  return (
+    (parsed.protocol === "https:" || parsed.protocol === "http:") &&
+    parsed.hostname.toLowerCase() === "github.com" &&
+    parsed.port === "" &&
+    repository === "1ma-ai/1ma"
+  );
+}
+
+// Why an installed copy of a 1ma plugin is not one 1ma can take over, or
+// null: git from 1ma's repository and its plugins/<name>, or a folder the
+// Linux release script marked.
+export function oneMaCopySourceProblem(
+  row: Pick<PluginRow, "sourceKind" | "sourceGitUrl" | "sourceGitSubdirectory" | "rootDir" | "source">,
+  name: string,
+): string | null {
+  if (row.sourceKind === "git") {
+    return row.sourceGitUrl !== null &&
+      isOneMaRepository(row.sourceGitUrl) &&
+      row.sourceGitSubdirectory === `plugins/${name}`
+      ? null
+      : `it is installed from ${row.source}, not from 1ma's repository`;
+  }
+  if (row.sourceKind === "path") {
+    let repository: unknown = null;
+    try {
+      repository = JSON.parse(readFileSync(join(row.rootDir, ".1ma-release.json"), "utf8")).repository;
+    } catch {}
+    return typeof repository === "string" && isOneMaRepository(repository)
+      ? null
+      : `${row.rootDir} is not a 1ma release install (no .1ma-release.json)`;
+  }
+  return `it is installed from ${row.source}`;
+}
+
+// Before a copy is taken over or a 1ma plugin first built in: one copy of the
+// whole database from before the first move, as a last resort (never
+// replaced), and how each 1ma plugin was installed, recorded per plugin the
+// first time it moves.
+export async function saveOneMaStateBeforeBuiltins(args: {
+  db: DbConnection;
+  dataDir: string;
+  pluginIds: readonly string[];
+}): Promise<boolean> {
+  const target = oneMaDatabaseCopyPath(args.dataDir);
+  let copied = false;
+  if (!(await exists(target))) {
+    const partial = `${target}.partial`;
+    await mkdir(join(args.dataDir, "backups"), { recursive: true });
+    try {
+      await args.db.$client.backup(partial);
+      await rename(partial, target);
+      copied = true;
+    } catch (error) {
+      await rm(partial, { force: true });
+      throw error;
+    }
+  }
+  const previous = readValue<PreviousInstalls>(args.db, PREVIOUS_KEY) ?? {};
+  const missing = args.pluginIds.filter((id) => !Object.hasOwn(previous, id));
+  if (missing.length > 0) {
+    for (const id of missing) {
+      const row = args.db.select().from(installedPlugins).where(eq(installedPlugins.id, id)).get();
+      previous[id] = row === undefined || row.sourceKind === "builtin" ? null : describeInstall(row);
+    }
+    writeValue(args.db, PREVIOUS_KEY, previous);
+  }
+  return copied;
+}
+
+// Writes a built-in 1ma row only when no rollback is pending, in one
+// transaction with that check.
+export function writeOneMaBuiltinUnlessRollingBack(db: DbConnection, write: () => void): boolean {
+  return db.transaction(
+    (tx) => {
+      if (oneMaRollbackPending(tx)) return false;
+      write();
+      return true;
+    },
+    { behavior: "immediate" },
+  );
+}
+
+async function withDataFolderClaim<T>(
+  dataDir: string,
+  pid: number,
+  now: number,
+  work: () => Promise<T> | T,
+): Promise<T> {
+  const claimed = await claimBbAppRuntimeFile({
+    dataDir,
+    entryPath: "one-ma-rollback",
+    pid,
+    serverUrl: "none",
+    startedAt: new Date(now).toISOString(),
+    surface: "1ma-rollback",
+    version: "1",
+  });
+  if (!claimed) {
+    const running = await readBbAppRuntimeFile(dataDir);
+    throw new Error(
+      `1ma is running on this data (process ${String(running?.pid)}); stop it and run this again`,
+    );
+  }
+  try {
+    return await work();
+  } finally {
+    await clearOwnBbAppRuntimeFile({ dataDir, pid });
+  }
+}
+
+function describe(id: string, row: PluginRow, previous: PreviousInstalls | null): string {
+  if (row.removedAt !== null) return `${id}: you had removed it, so do not install it again`;
+  if (previous !== null && Object.hasOwn(previous, id) && previous[id] === null) {
+    return `${id}: came with the built-in version; install it in the older 1ma only if you want it; its settings and data are kept`;
+  }
+  const how = previous?.[id] ?? "source unknown";
+  return row.enabled
+    ? `${id}: install it again in the older 1ma, ${how}; its settings and data are kept`
+    : `${id}: install it again in the older 1ma, ${how}, and turn it off, as it was; its settings and data are kept`;
+}
+
+// With 1ma stopped: moves the built-in 1ma rows into the pending rollback and
+// removes them, in one transaction. A repeated run keeps what an earlier one
+// saved. Returns what to tell the owner.
+export async function prepareOneMaRollback(args: {
+  db: DbConnection;
+  dataDir: string;
+  pluginIds: readonly string[];
+  pid?: number;
+  now?: number;
+}): Promise<string[]> {
+  const now = args.now ?? Date.now();
+  return withDataFolderClaim(args.dataDir, args.pid ?? process.pid, now, () =>
+    args.db.transaction(
+      (tx) => {
+        const pending = readValue<PendingRollback>(tx, ROLLBACK_KEY) ?? { createdAt: now, rows: {} };
+        const notes: string[] = [];
+        for (const id of args.pluginIds) {
+          const row = tx.select().from(installedPlugins).where(eq(installedPlugins.id, id)).get();
+          if (row === undefined) continue;
+          if (row.sourceKind !== "builtin") {
+            notes.push(`${id}: installed from ${row.source}, left as it is`);
+            continue;
+          }
+          pending.rows[id] = row;
+          tx.delete(installedPlugins).where(eq(installedPlugins.id, id)).run();
+        }
+        writeValue(tx, ROLLBACK_KEY, pending);
+        const previous = readValue<PreviousInstalls>(tx, PREVIOUS_KEY);
+        return [
+          ...args.pluginIds.flatMap((id) => {
+            const row = pending.rows[id];
+            return row === undefined ? [] : [describe(id, row, previous)];
+          }),
+          ...notes,
+        ];
+      },
+      { behavior: "exclusive" },
+    ),
+  );
+}
+
+export interface ResumeResult {
+  finished: boolean;
+  lines: string[];
+}
+
+// With 1ma stopped: ends a pending rollback, all at once or not at all. For
+// each removed plugin: not installed again in the older version, its row comes
+// back as it was (enabled or off, removed or not); installed again from 1ma's
+// repository or release folder, this version takes it over at its next start,
+// or leaves it installed when it is newer than the built-in (the takeover's
+// own rule), and records it anew. Installed again from any other source, it
+// is a conflict: nothing changes and the rollback stays prepared, unless
+// replaceOtherCopies, which unregisters that copy, keeping the data under its
+// id (a plain removal would delete it), and brings the built-in back.
+export async function resumeOneMa(args: {
+  db: DbConnection;
+  dataDir: string;
+  builtinVersions?: Readonly<Record<string, string>>;
+  replaceOtherCopies?: boolean;
+  pid?: number;
+  now?: number;
+}): Promise<ResumeResult> {
+  const now = args.now ?? Date.now();
+  return withDataFolderClaim(args.dataDir, args.pid ?? process.pid, now, () =>
+    args.db.transaction(
+      (tx): ResumeResult => {
+        const pending = readValue<PendingRollback>(tx, ROLLBACK_KEY);
+        if (pending === null) return { finished: true, lines: ["nothing to resume"] };
+        type Step =
+          | { id: string; kind: "restore"; row: PluginRow; replacing: PluginRow | null }
+          | { id: string; kind: "take-over" | "stays"; note: string }
+          | { id: string; kind: "conflict"; note: string };
+        const steps: Step[] = Object.entries(pending.rows).map(([id, row]) => {
+          const current = tx.select().from(installedPlugins).where(eq(installedPlugins.id, id)).get();
+          if (current === undefined) return { id, kind: "restore", row, replacing: null };
+          const problem = oneMaCopySourceProblem(current, id);
+          if (problem !== null) {
+            return args.replaceOtherCopies === true
+              ? { id, kind: "restore", row, replacing: current }
+              : { id, kind: "conflict", note: problem };
+          }
+          const shipped = args.builtinVersions?.[id];
+          const installed = semver.valid(current.version);
+          if (shipped !== undefined) {
+            const why =
+              installed === null || semver.valid(shipped) === null
+                ? `its version ${current.version} cannot be compared with the built-in ${shipped}`
+                : semver.gt(installed, shipped)
+                  ? `its ${current.version} is newer than the built-in ${shipped}`
+                  : null;
+            if (why !== null) {
+              return {
+                id,
+                kind: "stays",
+                note: `installed by the older 1ma, and ${why}; it stays installed from ${current.source}`,
+              };
+            }
+          }
+          return { id, kind: "take-over", note: "installed by the older 1ma; built in again at the next start" };
+        });
+        const conflicts = steps.filter((step) => step.kind === "conflict");
+        if (conflicts.length > 0) {
+          return {
+            finished: false,
+            lines: [
+              ...conflicts.map((step) => `${step.id}: ${step.note}`),
+              "not resumed, nothing changed: the way back stays prepared. Run this again with --replace-other-copies to unregister those copies, keeping the data of their ids, and bring the built-in plugins back",
+            ],
+          };
+        }
+        const previous = readValue<PreviousInstalls>(tx, PREVIOUS_KEY) ?? {};
+        const lines: string[] = [];
+        for (const step of steps) {
+          if (step.kind === "restore") {
+            if (step.replacing !== null) {
+              tx.delete(installedPlugins).where(eq(installedPlugins.id, step.id)).run();
+            }
+            tx.insert(installedPlugins).values(step.row).run();
+            lines.push(
+              step.replacing === null
+                ? `${step.id}: back as it was`
+                : `${step.id}: the copy from ${step.replacing.source} was unregistered, its data kept; back as it was`,
+            );
+          } else if (step.kind !== "conflict") {
+            delete previous[step.id];
+            lines.push(`${step.id}: ${step.note}`);
+          }
+        }
+        deleteValue(tx, ROLLBACK_KEY);
+        writeValue(tx, PREVIOUS_KEY, previous);
+        return { finished: true, lines };
+      },
+      { behavior: "exclusive" },
+    ),
+  );
+}
