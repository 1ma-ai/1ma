+  describe("a built-in 1ma plugin already installed as a copy", () => {
+    const repository = "https://github.com/1ma-ai/1ma.git";
+
+    async function start(copy: {
+      kind: "git" | "path";
+      repo?: string;
+      version?: string;
+      marker?: boolean;
+    }) {
+      const builtinRoot = await writePlugin(join(workDir, "builtin"), {
+        name: "bb-plugin-1ma-brand",
+        version: "0.4.0",
+        serverSource: "export default function plugin() {}",
+      });
+      const copyRoot = await writePlugin(join(workDir, "copy"), {
+        name: "bb-plugin-1ma-brand",
+        version: copy.version ?? "0.3.1",
+        serverSource: "export default function plugin() {}",
+      });
+      if (copy.marker === true) {
+        await writeFile(
+          join(copyRoot, ".1ma-release.json"),
+          JSON.stringify({ repository: "https://github.com/1ma-ai/1ma", commit: "a".repeat(40) }),
+        );
+      }
+      const git = copy.kind === "git";
+      upsertInstalledPlugin(db, {
+        id: "1ma-brand",
+        source: git ? `git:${copy.repo ?? repository}@^0` : `path:${copyRoot}`,
+        provenance: { kind: "direct" },
+        sourceIntent: git
+          ? {
+              kind: "git",
+              url: copy.repo ?? repository,
+              subdirectory: "plugins/1ma-brand",
+              selector: { kind: "range", range: "^0", tagPrefix: "1ma-brand/", resolvedTag: "1ma-brand/v0.3.1" },
+            }
+          : { kind: "path", canonicalPath: copyRoot },
+        exactResolution: git ? { kind: "git", commit: "b".repeat(40) } : { kind: "path" },
+        updateState: {
+          lastCheckAt: null,
+          availableCompatibleVersion: null,
+          newestIncompatibleVersion: null,
+          statusDetail: null,
+        },
+        activeArtifactId: null,
+        rootDir: copyRoot,
+        version: copy.version ?? "0.3.1",
+        enabled: false,
+        enabledFollowsDefault: false,
+      });
+      setPluginSettingsValues(db, "1ma-brand", { accent: "#ff6600" });
+      const warn = vi.spyOn(logger, "warn");
+      service = createPluginService({
+        aiServices: createAiServiceRegistry(),
+        telemetry: createNoopTelemetryService(),
+        db,
+        hub: {
+          getDaemonSessionIdForHost: () => null,
+          notifyPluginChanged: () => {},
+          onWatchedTargets: () => () => {},
+          notifyPluginSignal: () => 0,
+          notifySystem: () => {},
+        },
+        logger,
+        dataDir: join(workDir, "data"),
+        appVersion: "0.9.0",
+        loadTimeoutMs: 2000,
+        bundledPlugins: [
+          {
+            name: "1ma-brand",
+            pluginId: "1ma-brand",
+            autoInstall: true,
+            defaultEnabled: true,
+            rootDir: builtinRoot,
+          },
+        ],
+      });
+      await service.start();
+      const backups = await readdir(join(workDir, "data", "backups")).catch(() => []);
+      const lines = warn.mock.calls.map((call) => `warn ${String(call[0])}`);
+      return { row: getInstalledPluginRegistration(db, "1ma-brand"), lines, backups };
+    }
+
+    it.each([
+      ["installed from 1ma's repository", { kind: "git" as const }],
+      ["installed by the Linux release script", { kind: "path" as const, marker: true }],
+    ])("takes over a copy %s, keeping its enablement and settings, after a database copy", async (_case, copy) => {
+      const { row, backups } = await start(copy);
+      expect(row).toMatchObject({ source: "builtin:1ma-brand", version: "0.4.0", enabled: false });
+      expect(getPluginSettingsValues(db, "1ma-brand")).toEqual({ accent: "#ff6600" });
+      expect(backups).toEqual([expect.stringMatching(/^before-1ma-builtins-0\.9\.0-\d+\.db$/u)]);
+    });
+
+    it.each([
+      ["from another repository", { kind: "git" as const, repo: "https://github.com/someone/1ma-brand.git" }, "not from 1ma's repository"],
+      ["from a folder the release script did not install", { kind: "path" as const }, "not a 1ma release install"],
+      ["newer than the built-in", { kind: "git" as const, version: "0.5.0" }, "newer than the built-in 0.4.0"],
+    ])("leaves a copy %s in place and says why", async (_case, copy, reason) => {
+      const { row, lines, backups } = await start(copy);
+      expect(row?.source.startsWith("builtin:")).toBe(false);
+      expect(getPluginSettingsValues(db, "1ma-brand")).toEqual({ accent: "#ff6600" });
+      expect(lines.some((line) => line.startsWith("warn built-in 1ma plugin 1ma-brand left the installed copy in place") && line.includes(reason))).toBe(true);
+      expect(backups).toEqual([]);
+    });
+  });
+
   it.each(["startup", "retry"])(
     "reports starting while a %s factory is pending",
     async (mode) => {
