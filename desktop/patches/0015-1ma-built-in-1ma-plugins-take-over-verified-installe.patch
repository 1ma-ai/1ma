+    if (ids.some((id) => getInstalledPluginRegistration(deps.db, id)?.sourceKind === "builtin")) {
+      return null;
+    }
+    try {
+      if (
+        await saveOneMaRollbackSet({
+          db: deps.db,
+          dataDir: deps.dataDir,
+          appVersion: deps.appVersion,
+          pluginIds: ids,
+          now: Date.now(),
+        })
+      ) {
+        logger.info(
+          `saved the 1ma plugins' installs to ${oneMaRollbackDirectory(deps.dataDir)} before they are built in`,
+        );
+      }
+      return null;
+    } catch (error) {
+      return `could not save the installs from before first: ${
+        error instanceof Error ? error.message : String(error)
+      }`;
+    }
+  }
