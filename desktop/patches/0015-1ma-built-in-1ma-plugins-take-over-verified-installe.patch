 import { join, resolve } from "node:path";
 import { isFsErrorWithCode } from "../lib/fs-errors.js";
 import {
@@ -27,6 +28,7 @@ import {
 } from "@bb/db";
 import {
   BUILTIN_PLUGIN_ID_PREFIX,
+  ONE_MA_PLUGINS,
   SHIPPED_PLUGINS,
   builtinPluginSource,
   type BundledPluginRegistration,
@@ -765,6 +767,80 @@ export function createPluginRegistration(context: PluginRegistrationContext) {
     });
   }
 
+  // A 1ma plugin that became built in may still be installed from 1ma's
+  // repository or from the Linux release folder. Such a copy is taken over:
+  // its row moves to the built-in source and keeps its enablement, settings,
+  // secrets, schedules and data, which belong to the plugin id. Only a
+  // verifiable 1ma source qualifies, and never a copy newer than the built-in.
+  const oneMaPluginNames = new Set(ONE_MA_PLUGINS.map((plugin) => plugin.name));
+  const ONE_MA_REPOSITORY = "https://github.com/1ma-ai/1ma";
+  let takeoverSnapshot: Promise<void> | null = null;
+
+  function normalizedRepository(url: string): string {
+    return url
+      .replace(/^git\+/u, "")
+      .replace(/\.git$/u, "")
+      .replace(/\/+$/u, "")
+      .toLowerCase();
+  }
+
+  async function oneMaTakeoverProblem(
+    existing: InstalledPluginRow,
+    name: string,
+    builtinVersion: string,
+  ): Promise<string | null> {
+    const intent = existing.sourceIntent;
+    if (intent.kind === "git") {
+      if (
+        normalizedRepository(intent.url) !== ONE_MA_REPOSITORY ||
+        intent.subdirectory !== `plugins/${name}`
+      ) {
+        return `it is installed from ${existing.source}, not from 1ma's repository`;
+      }
+    } else if (intent.kind === "path") {
+      let repository: unknown = null;
+      try {
+        repository = JSON.parse(
+          await readFile(join(existing.rootDir, ".1ma-release.json"), "utf8"),
+        ).repository;
+      } catch {}
+      if (
+        typeof repository !== "string" ||
+        normalizedRepository(repository) !== ONE_MA_REPOSITORY
+      ) {
+        return `${existing.rootDir} is not a 1ma release install (no .1ma-release.json)`;
+      }
+    } else {
+      return `it is installed from ${existing.source}`;
+    }
+    const installed = semver.valid(existing.version);
+    const shipped = semver.valid(builtinVersion);
+    if (installed === null || shipped === null) {
+      return `its version ${existing.version} cannot be compared with ${builtinVersion}`;
+    }
+    if (semver.gt(installed, shipped)) {
+      return `the installed ${existing.version} is newer than the built-in ${builtinVersion}`;
+    }
+    return null;
+  }
+
+  // One copy of the database before the first takeover: an app version from
+  // before the 1ma plugins were built in deletes their rows and settings at
+  // start, so going back is done by restoring this copy.
+  function snapshotBeforeTakeover(): Promise<void> {
+    takeoverSnapshot ??= (async () => {
+      const directory = join(deps.dataDir, "backups");
+      await mkdir(directory, { recursive: true });
+      const target = join(
+        directory,
+        `before-1ma-builtins-${deps.appVersion}-${Date.now()}.db`,
+      );
+      await deps.db.$client.backup(target);
+      logger.info(`saved the database to ${target} before taking over the 1ma plugins`);
+    })();
+    return takeoverSnapshot;
+  }
+
   async function reconcileBundled(): Promise<void> {
     for (const bundled of bundledPlugins) {
       const source = builtinPluginSource(bundled.name);
@@ -803,6 +879,37 @@ export function createPluginRegistration(context: PluginRegistrationContext) {
           name: bundled.name,
         })
       ) {
+        if (oneMaPluginNames.has(bundled.name)) {
+          const problem = await oneMaTakeoverProblem(
+            existing,
+            bundled.name,
+            manifest.version,
+          );
+          if (problem !== null) {
+            logger.warn(
+              `built-in 1ma plugin ${bundled.name} left the installed copy in place: ${problem}`,
+            );
+            continue;
+          }
+          await snapshotBeforeTakeover();
+          upsertInstalledPlugin(deps.db, {
+            id: manifest.id,
+            source,
+            provenance,
+            sourceIntent: { kind: "builtin", name: bundled.name },
+            exactResolution: { kind: "builtin" },
+            updateState: emptyPluginUpdateState(),
+            activeArtifactId: null,
+            rootDir: bundled.rootDir,
+            version: manifest.version,
+            enabled: existing.enabled,
+            enabledFollowsDefault: existing.enabledFollowsDefault,
+          });
+          logger.info(
+            `built-in 1ma plugin ${bundled.name} took over the copy installed from ${existing.source}`,
+          );
+          continue;
+        }
         logger.warn(
           `bundled plugin ${bundled.name} resolved to id "${manifest.id}", but that id is already installed from ${existing.source}; skipping bundled reconciliation`,
         );
