@@ -38,6 +38,13 @@ const claudeAccountFileSchema = z.object({
     .nullish(),
 });
 
+const claudeSettingsFileSchema = z.object({
+  env: z.record(z.string(), z.unknown()).nullish(),
+});
+
+const ESSENTIAL_TRAFFIC_ONLY_VARIABLE =
+  "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC";
+
 async function claudeExecutable(): Promise<string> {
   const explicit = process.env.BB_CLAUDE_CODE_EXECUTABLE?.trim();
   if (explicit) return explicit;
@@ -261,6 +268,26 @@ async function readAccountUuid(env: NodeJS.ProcessEnv): Promise<string | null> {
   }
 }
 
+async function essentialTrafficOnlySource(
+  env: NodeJS.ProcessEnv,
+): Promise<string | null> {
+  if (env[ESSENTIAL_TRAFFIC_ONLY_VARIABLE]) return "the server's environment";
+  const settingsFile = env.CLAUDE_CONFIG_DIR
+    ? path.join(env.CLAUDE_CONFIG_DIR, "settings.json")
+    : path.join(os.homedir(), ".claude", "settings.json");
+  try {
+    const parsed = claudeSettingsFileSchema.safeParse(
+      JSON.parse(await fs.readFile(settingsFile, "utf8")),
+    );
+    const value = parsed.success
+      ? parsed.data.env?.[ESSENTIAL_TRAFFIC_ONLY_VARIABLE]
+      : undefined;
+    return typeof value === "string" && value !== "" ? settingsFile : null;
+  } catch {
+    return null;
+  }
+}
+
 function isSignedIn(account: AccountInfo): boolean {
   return (
     (account.apiProvider ?? "firstParty") !== "firstParty" ||
@@ -466,12 +493,16 @@ export async function getClaudeProviderUsage(): Promise<ProviderUsageResult> {
   if (!isSignedIn(account) || !usage.rate_limits_available) {
     return { supported: true, usage: { status: "unauthenticated" } };
   }
-  if (usage.rate_limits === null) {
+  const essentialTrafficOnly = await essentialTrafficOnlySource(args.env);
+  if (essentialTrafficOnly !== null || usage.rate_limits === null) {
     return {
       supported: true,
       usage: {
         status: "error",
-        message: "Claude Code could not read this account's plan usage.",
+        message:
+          essentialTrafficOnly === null
+            ? "Claude Code could not read this account's plan usage."
+            : `Claude Code does not fetch plan usage while ${ESSENTIAL_TRAFFIC_ONLY_VARIABLE} is set in ${essentialTrafficOnly}. DISABLE_TELEMETRY=1 keeps telemetry off without blocking it.`,
         ...accountFields(account),
       },
     };
