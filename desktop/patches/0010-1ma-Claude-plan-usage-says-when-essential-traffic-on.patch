--- /dev/null
+++ b/plugins/provider-claude-code/src/bridge/provider-maintenance.essential-traffic.test.ts
@@ -0,0 +1,145 @@
+import type {
+  AccountInfo,
+  SDKControlGetUsageResponse,
+} from "@anthropic-ai/claude-agent-sdk";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+const state = vi.hoisted(() => ({
+  account: {
+    email: "claude@example.com",
+    subscriptionType: "Claude Pro",
+    apiProvider: "firstParty",
+  } as AccountInfo,
+  usage: {} as Pick<
+    SDKControlGetUsageResponse,
+    "rate_limits_available" | "rate_limits"
+  >,
+  files: new Map<string, string>(),
+}));
+
+vi.mock("./initialization-probe.js", () => ({
+  probeClaudeInitialization: () => Promise.resolve({ account: state.account }),
+  probeClaudeUsage: () =>
+    Promise.resolve({ account: state.account, usage: state.usage }),
+}));
+
+vi.mock("node:fs/promises", () => ({
+  default: {
+    readFile: (file: string) => {
+      const content = state.files.get(file);
+      return content === undefined
+        ? Promise.reject(new Error(`ENOENT: no such file, open '${file}'`))
+        : Promise.resolve(content);
+    },
+  },
+}));
+
+vi.mock("@get-bb/plugin-sdk/provider-bridge", async (importOriginal) => ({
+  ...(await importOriginal<
+    typeof import("@get-bb/plugin-sdk/provider-bridge")
+  >()),
+  experimental_resolveExecutablePath: () => Promise.resolve("/test/claude"),
+}));
+
+import { getClaudeProviderUsage } from "./provider-maintenance.js";
+
+const variable = "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC";
+const cachedLimits = {
+  five_hour: { utilization: 67, resets_at: "2026-11-11T11:40:00Z" },
+  seven_day: null,
+};
+
+function settings(env: Record<string, string>): string {
+  return JSON.stringify({ env });
+}
+
+function blockedBy(source: string) {
+  return {
+    supported: true,
+    usage: {
+      status: "error",
+      message: `Claude Code does not fetch plan usage while ${variable} is set in ${source}. DISABLE_TELEMETRY=1 keeps telemetry off without blocking it.`,
+      accountEmail: "claude@example.com",
+      planLabel: "Pro",
+    },
+  };
+}
+
+beforeEach(() => {
+  vi.stubEnv(variable, undefined);
+  vi.stubEnv("CLAUDE_CONFIG_DIR", undefined);
+  state.usage = { rate_limits_available: true, rate_limits: cachedLimits };
+  state.files = new Map();
+});
+
+afterEach(() => {
+  vi.unstubAllEnvs();
+});
+
+describe("Claude plan usage in essential-traffic-only mode", () => {
+  it("names the server's environment instead of showing the numbers Claude Code cached", async () => {
+    vi.stubEnv(variable, "1");
+
+    expect(await getClaudeProviderUsage()).toEqual(
+      blockedBy("the server's environment"),
+    );
+  });
+
+  it("finds the variable in the settings of the profile CLAUDE_CONFIG_DIR selects", async () => {
+    const profile = path.resolve("/profiles/work");
+    vi.stubEnv("CLAUDE_CONFIG_DIR", profile);
+    const file = path.join(profile, "settings.json");
+    state.files.set(file, settings({ [variable]: "1" }));
+
+    expect(await getClaudeProviderUsage()).toEqual(blockedBy(file));
+  });
+
+  it("finds the variable in ~/.claude/settings.json without CLAUDE_CONFIG_DIR", async () => {
+    const file = path.join(os.homedir(), ".claude", "settings.json");
+    state.files.set(
+      file,
+      settings({ [variable]: "1", DISABLE_TELEMETRY: "1" }),
+    );
+
+    expect(await getClaudeProviderUsage()).toEqual(blockedBy(file));
+  });
+
+  it("shows the usage when the variable is empty, which Claude Code treats as unset", async () => {
+    vi.stubEnv(variable, "");
+    state.files.set(
+      path.join(os.homedir(), ".claude", "settings.json"),
+      settings({ [variable]: "" }),
+    );
+
+    expect(await getClaudeProviderUsage()).toMatchObject({
+      usage: { status: "ok" },
+    });
+  });
+
+  it("shows the usage when the settings file is not valid JSON", async () => {
+    state.files.set(
+      path.join(os.homedir(), ".claude", "settings.json"),
+      "{ not json",
+    );
+
+    expect(await getClaudeProviderUsage()).toMatchObject({
+      usage: { status: "ok" },
+    });
+  });
+
+  it("keeps the general message when Claude Code returns no limits without the variable", async () => {
+    state.usage = { rate_limits_available: true, rate_limits: null };
+
+    expect(await getClaudeProviderUsage()).toEqual({
+      supported: true,
+      usage: {
+        status: "error",
+        message: "Claude Code could not read this account's plan usage.",
+        accountEmail: "claude@example.com",
+        planLabel: "Pro",
+      },
+    });
+  });
+});
diff --git a/plugins/provider-claude-code/src/bridge/provider-maintenance.ts b/plugins/provider-claude-code/src/bridge/provider-maintenance.ts
index 053f437..3a76374 100644
