+// 1ma publishes its server package and version feeds as GitHub release
+// assets; on npm, bb-app is bb's own package.
+export const SERVER_RELEASES_DOWNLOAD_URL =
+  "https://github.com/1ma-ai/1ma/releases/download";
+
+export function formatServerVersionFeedUrl(
+  channel: "latest" | "nightly",
+): string {
+  return `${SERVER_RELEASES_DOWNLOAD_URL}/desktop-${channel}/server-version.json`;
+}
+
+export interface ServerPackageDownload {
+  checksumsUrl: string;
+  fileName: string;
+  packageUrl: string;
+}
+
+export function formatServerPackageDownload(
+  version: string,
+): ServerPackageDownload {
+  const release = `${SERVER_RELEASES_DOWNLOAD_URL}/desktop/v${version}`;
+  const fileName = `1ma-server-${version}.tgz`;
+  return {
+    checksumsUrl: `${release}/SHA256SUMS`,
+    fileName,
+    packageUrl: `${release}/${fileName}`,
+  };
+}
+
