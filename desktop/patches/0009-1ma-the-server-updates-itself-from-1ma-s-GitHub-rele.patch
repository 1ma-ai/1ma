+export function parseUpdateCommandPrefix(
+  value: string | undefined,
+): readonly string[] {
+  return (value ?? "").trim().split(/\s+/u).filter((part) => part.length > 0);
+}
+
+export function findPackageChecksum(
+  checksums: string,
+  fileName: string,
+): string | null {
+  for (const line of checksums.split(/\r?\n/u)) {
+    const match = /^([0-9a-f]{64}) [ *](.+)$/u.exec(line.trim());
+    if (match?.[2] === fileName) return match[1] ?? null;
+  }
+  return null;
+}
+
+async function fetchOk(
+  fetchImpl: typeof fetch,
+  url: string,
+  signal: AbortSignal | undefined,
+): Promise<Response> {
+  const timeout = AbortSignal.timeout(PACKAGE_DOWNLOAD_TIMEOUT_MS);
+  const response = await fetchImpl(url, {
+    signal:
+      signal === undefined ? timeout : AbortSignal.any([signal, timeout]),
+  });
+  if (!response.ok) {
+    throw new Error(
+      `Downloading ${url} failed with HTTP ${String(response.status)}.`,
+    );
+  }
+  return response;
+}
+
+export async function downloadServerPackage(args: {
+  directory: string;
+  fetchImpl: typeof fetch;
+  signal?: AbortSignal;
+  version: string;
+}): Promise<string> {
+  const download = formatServerPackageDownload(args.version);
+  const checksums = await (
+    await fetchOk(args.fetchImpl, download.checksumsUrl, args.signal)
+  ).text();
+  const expected = findPackageChecksum(checksums, download.fileName);
+  if (expected === null) {
+    throw new Error(
+      `${download.checksumsUrl} does not list ${download.fileName}.`,
+    );
+  }
+  const body = Buffer.from(
+    await (
+      await fetchOk(args.fetchImpl, download.packageUrl, args.signal)
+    ).arrayBuffer(),
+  );
+  const actual = createHash("sha256").update(body).digest("hex");
+  if (actual !== expected) {
+    throw new Error(
+      `${download.fileName} does not match its SHA-256 in ${download.checksumsUrl}.`,
+    );
+  }
+  const path = join(args.directory, download.fileName);
+  await writeFile(path, body);
+  return path;
+}
