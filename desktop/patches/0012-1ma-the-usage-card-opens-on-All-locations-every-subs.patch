+
+it("offers All, which lists shared and machine accounts together and shows a known account once", async () => {
+  const keys: Record<string, string | null> = {
+    plus: "openai:chatgpt:plus",
+    prolite: "openai:chatgpt:prolite",
+    login: "openai:chatgpt:prolite",
+    go: null,
+  };
+  const rpc = vi.fn(async ({ pluginId, method, input }) => {
+    if (method === usageListMethod) {
+      if (pluginId === "pool")
+        return {
+          label: "Account Pooler",
+          resources: ["plus", "prolite"].map((id) => ({
+            id,
+            providerId: "codex",
+            accountKey: keys[id],
+            label: `${id}@example.com`,
+            scope: { kind: "shared" },
+          })),
+        };
+      return {
+        resources: [
+          {
+            id: pluginId === "local" ? "login" : "go",
+            providerId: pluginId === "local" ? "codex" : "opencode",
+            accountKey: pluginId === "local" ? keys.login : keys.go,
+            label: pluginId === "local" ? "Codex" : "OpenCode Go",
+            scope: { kind: "host", hostId: "mac", hostName: "MacBook" },
+          },
+        ],
+      };
+    }
+    return {
+      accountKey: keys[input.resourceId] ?? null,
+      observedAt: 123,
+      usage: {
+        status: "ok",
+        accountEmail: `${input.resourceId}@example.com`,
+        planLabel: null,
+        windows: [],
+      },
+    };
+  });
+  const host = createFakePluginHost({
+    pluginId: "provider-usage",
+    sdk: {
+      system: { config: async () => ({ primaryHostId: null }) },
+      hosts: {
+        list: async () => [
+          makeHostResponse({ id: "mac", name: "MacBook", status: "connected" }),
+        ],
+      },
+      providers: {
+        list: async () => [
+          { id: "codex", displayName: "Codex", logoUrl: "/codex.svg" },
+          { id: "opencode", displayName: "OpenCode", logoUrl: "/oc.svg" },
+        ],
+      },
+      plugins: {
+        experimental_discoverRpc: async () =>
+          ["pool", "local", "acp"].map((pluginId) => ({
+            pluginId,
+            displayName: pluginId,
+            method: usageListMethod,
+          })),
+        callRpc: rpc,
+      },
+    },
+  });
+  plugin(host.bb);
+  try {
+    const snapshot = await host.harness.behavior.callRpc("getUsage", {
+      force: false,
+      machineIds: ["all"],
+      providerIds: ["codex", "opencode"],
+      maxAgeMs: 0,
+    });
+    expect(
+      snapshot.machines.map(
+        (machine: { id: string; providers: { id: string }[] }) => [
+          machine.id,
+          machine.providers.map((provider) => provider.id),
+        ],
+      ),
+    ).toEqual([
+      ["all", ["pool:plus", "pool:prolite", "acp:go"]],
+      ["mac", ["local:login", "acp:go"]],
+      ["source:pool", ["pool:plus", "pool:prolite"]],
+    ]);
+    expect(snapshot.machines[0]).toMatchObject({
+      displayName: "All locations",
+      status: "connected",
+      error: null,
+    });
+    expect(
+      rpc.mock.calls
+        .filter(([args]) => args.method === usageFetchMethod)
+        .map(([args]) => `${args.pluginId}:${args.input.resourceId}`)
+        .sort(),
+    ).toEqual(["acp:go", "local:login", "pool:plus", "pool:prolite"]);
+  } finally {
+    await host.harness.lifecycle.dispose();
+  }
+});
