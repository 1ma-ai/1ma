index 0000000..c331617
--- /dev/null
+++ b/apps/app/src/views/thread-detail/useParentThreadSection.test.ts
@@ -0,0 +1,44 @@
+// @vitest-environment jsdom
+
+import { cleanup, renderHook } from "@testing-library/react";
+import { afterEach, expect, it, vi } from "vitest";
+import { useThread } from "@/hooks/queries/thread-queries";
+import { makeThreadResponse } from "@/test/fixtures/thread-responses";
+import { useParentThreadSection } from "./useParentThreadSection";
+
+vi.mock("@/hooks/queries/thread-queries", () => ({
+  useThread: vi.fn(() => ({ data: undefined })),
+}));
+
+afterEach(() => {
+  cleanup();
+  vi.clearAllMocks();
+});
+
+it("does not load the source of a continued chat, which shows no banner", () => {
+  const thread = makeThreadResponse({
+    id: "thr_continuation",
+    originKind: null,
+    parentThreadId: null,
+    sourceThreadId: "thr_source",
+  });
+
+  const { result } = renderHook(() => useParentThreadSection(thread, true));
+
+  expect(result.current).toBeNull();
+  expect(useThread).not.toHaveBeenCalledWith("thr_source");
+});
+
+it("loads the source of a fork for its banner", () => {
+  const thread = makeThreadResponse({
+    id: "thr_fork",
+    originKind: "fork",
+    parentThreadId: null,
+    sourceThreadId: "thr_source",
+  });
+
+  const { result } = renderHook(() => useParentThreadSection(thread, true));
+
+  expect(result.current?.relationship).toBe("fork");
+  expect(useThread).toHaveBeenCalledWith("thr_source");
+});
