From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 1ma <hello@1ma.ai>
Date: Sat, 14 Nov 2026 22:24:59 +0100
Subject: [PATCH] 1ma: the 1ma plugins are built in

1ma Brand, Theme, Server Switcher and Auto Updates ship inside the app and
update with it. They are a separate list, ONE_MA_PLUGINS: they live in the
1ma repository, not in this workspace, and the 1ma build puts each prepared
runtime at plugins/<name>/.bundled-runtime. SHIPPED_PLUGINS joins them to
bb's bundled plugins only where plugins are packaged, installed, shadow-
checked and ordered, so bb's catalog and its checks of its own bundled
plugins stay as they are.
---
 .../src/services/plugins/builtin-registry.ts  | 27 ++++++++++++++++++-
 .../services/plugins/plugin-registration.ts   |  4 +--
 .../src/services/plugins/plugin-runtime.ts    |  4 +--
 .../services/plugins/builtin-registry.test.ts | 20 ++++++++++++++
 packages/bundled-plugins/build.ts             |  4 +--
 5 files changed, 52 insertions(+), 7 deletions(-)

diff --git a/apps/server/src/services/plugins/builtin-registry.ts b/apps/server/src/services/plugins/builtin-registry.ts
index ab47686..3a9076d 100644
--- a/apps/server/src/services/plugins/builtin-registry.ts
+++ b/apps/server/src/services/plugins/builtin-registry.ts
@@ -291,6 +291,31 @@ export const BUNDLED_PLUGINS: readonly BundledPluginDefinition[] = [
   ...OFFICIAL_PLUGINS,
 ];
 
+/**
+ * The 1ma plugins. They live in the 1ma repository, not in this workspace:
+ * the 1ma build prepares each one with this tree's prepare-bundled and puts
+ * the runtime at plugins/<name>/.bundled-runtime. They ship and install like
+ * the bundled plugins above, but bb's own catalog and checks of its bundled
+ * plugins leave them out.
+ */
+export const ONE_MA_PLUGINS: readonly BundledPluginDefinition[] = [
+  "1ma-brand",
+  "1ma-theme",
+  "1ma-server-switcher",
+  "1ma-auto-updates",
+].map((name) => ({
+  name,
+  pluginId: name,
+  defaultEnabled: true,
+  autoInstall: true,
+}));
+
+/** Every plugin that ships inside the app: bb's bundled ones and 1ma's. */
+export const SHIPPED_PLUGINS: readonly BundledPluginDefinition[] = [
+  ...BUNDLED_PLUGINS,
+  ...ONE_MA_PLUGINS,
+];
+
 export interface RetiredBundledPlugin {
   pluginId: string;
   successorPluginId: string;
@@ -359,7 +384,7 @@ export function resolveBuiltinPluginRootPath(name: string): string {
 }
 
 export function listBundledPluginRegistrations(): BundledPluginRegistration[] {
-  return BUNDLED_PLUGINS.map((plugin) => ({
+  return SHIPPED_PLUGINS.map((plugin) => ({
     ...plugin,
     rootDir: resolveBuiltinPluginRootPath(plugin.name),
   }));
