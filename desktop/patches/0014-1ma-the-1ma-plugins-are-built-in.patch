From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 1ma <hello@1ma.ai>
Date: Sat, 14 Nov 2026 16:52:01 +0100
Subject: [PATCH] 1ma: the 1ma plugins are built in

1ma Brand, Theme, Server Switcher and Auto Updates ship inside the app and
update with it. They live in the 1ma repository, not in this workspace: the
1ma build prepares each one with this tree's prepare-bundled and puts the
runtime at plugins/<name>/.bundled-runtime, which packages/bundled-plugins
copies like any other. The bundled task-graph and id-prefix tests leave these
prebuilt entries out, and a test pins the list.
---
 .../src/services/plugins/builtin-registry.ts  | 19 +++++++++++++++++++
 .../services/plugins/builtin-registry.test.ts | 18 +++++++++++++++++-
 .../test/bundled-plugin-tasks.test.mjs        |  3 ++-
 3 files changed, 38 insertions(+), 2 deletions(-)

diff --git a/apps/server/src/services/plugins/builtin-registry.ts b/apps/server/src/services/plugins/builtin-registry.ts
index ab47686..1994b97 100644
--- a/apps/server/src/services/plugins/builtin-registry.ts
+++ b/apps/server/src/services/plugins/builtin-registry.ts
@@ -8,6 +8,11 @@ export interface BundledPluginDefinition {
   pluginId: string;
   autoInstall: boolean;
   defaultEnabled: boolean;
+  /**
+   * A 1ma plugin: it lives in the 1ma repository, not in this workspace, and
+   * the 1ma build puts its prepared runtime at plugins/<name>/.bundled-runtime.
+   */
+  prebuilt?: true;
 }
 
 export interface BundledPluginRegistration extends BundledPluginDefinition {
@@ -286,9 +291,23 @@ export const OFFICIAL_PLUGINS = [
   autoInstall: false,
 }));
 
+export const ONE_MA_PLUGINS: readonly BundledPluginDefinition[] = [
+  "1ma-brand",
+  "1ma-theme",
+  "1ma-server-switcher",
+  "1ma-auto-updates",
+].map((name) => ({
+  name,
+  pluginId: name,
+  defaultEnabled: true,
+  autoInstall: true,
+  prebuilt: true,
+}));
+
 export const BUNDLED_PLUGINS: readonly BundledPluginDefinition[] = [
   ...BUILTIN_PLUGINS,
   ...OFFICIAL_PLUGINS,
+  ...ONE_MA_PLUGINS,
 ];
 
 export interface RetiredBundledPlugin {
diff --git a/apps/server/test/services/plugins/builtin-registry.test.ts b/apps/server/test/services/plugins/builtin-registry.test.ts
index 8fed705..7c327f3 100644
--- a/apps/server/test/services/plugins/builtin-registry.test.ts
+++ b/apps/server/test/services/plugins/builtin-registry.test.ts
@@ -53,7 +53,8 @@ const UNPREFIXED_BUNDLED_PLUGIN_IDS = [
 
 describe("bundled plugin ids", () => {
   it("prefixes every bundled plugin added after the reservation with bb--", () => {
-    const unprefixed = BUNDLED_PLUGINS.map((plugin) => plugin.pluginId)
+    const unprefixed = BUNDLED_PLUGINS.filter((plugin) => plugin.prebuilt !== true)
+      .map((plugin) => plugin.pluginId)
       .filter((pluginId) => !pluginId.startsWith(BUILTIN_PLUGIN_ID_PREFIX))
       .sort();
 
@@ -61,6 +62,21 @@ describe("bundled plugin ids", () => {
   });
 });
 
+describe("1ma plugins", () => {
+  it("are built in, installed and enabled by default, and named with the 1ma- prefix", () => {
+    const oneMa = BUNDLED_PLUGINS.filter((plugin) => plugin.prebuilt === true);
+    expect(oneMa.map((plugin) => plugin.pluginId)).toEqual([
+      "1ma-brand",
+      "1ma-theme",
+      "1ma-server-switcher",
+      "1ma-auto-updates",
+    ]);
+    for (const plugin of oneMa) {
+      expect(plugin).toMatchObject({ name: plugin.pluginId, autoInstall: true, defaultEnabled: true });
+    }
+  });
+});
+
 describe("bundled plugin artifact resolution", () => {
   let root: string;
 
diff --git a/packages/scripts/test/bundled-plugin-tasks.test.mjs b/packages/scripts/test/bundled-plugin-tasks.test.mjs
index 444ccd1..68aab60 100644
--- a/packages/scripts/test/bundled-plugin-tasks.test.mjs
+++ b/packages/scripts/test/bundled-plugin-tasks.test.mjs
@@ -9,7 +9,8 @@ const turbo = JSON.parse(turboSource.replace(/^\s*\/\/.*$/gm, ""));
 
 describe("bundled plugin task graph", () => {
   it("prepares every registered plugin before assembly with separate output ownership", () => {
-    const expected = BUNDLED_PLUGINS.map(({ name }) => {
+    // 1ma plugins come prepared from the 1ma repository, outside this workspace.
+    const expected = BUNDLED_PLUGINS.filter((plugin) => plugin.prebuilt !== true).map(({ name }) => {
       const manifest = JSON.parse(
         readFileSync(resolve(root, "plugins", name, "package.json"), "utf8"),
       );
