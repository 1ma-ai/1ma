+describe("1ma plugins", () => {
+  it("ship and install after bb's bundled plugins, enabled, and stay out of bb's own list", () => {
+    expect(ONE_MA_PLUGINS.map((plugin) => plugin.pluginId)).toEqual([
+      "1ma-brand",
+      "1ma-theme",
+      "1ma-server-switcher",
+      "1ma-auto-updates",
+    ]);
+    for (const plugin of ONE_MA_PLUGINS) {
+      expect(plugin).toMatchObject({ name: plugin.pluginId, autoInstall: true, defaultEnabled: true });
+    }
+    expect(
+      listShippedPluginRegistrations().map((plugin) => plugin.pluginId),
+    ).toEqual([...BUNDLED_PLUGINS, ...ONE_MA_PLUGINS].map((plugin) => plugin.pluginId));
+    expect(
+      listBundledPluginRegistrations().map((plugin) => plugin.pluginId),
+    ).toEqual(BUNDLED_PLUGINS.map((plugin) => plugin.pluginId));
+    expect(BUNDLED_PLUGINS.some((plugin) => plugin.pluginId.startsWith("1ma-"))).toBe(false);
+  });
+});
+
