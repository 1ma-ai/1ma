+function executableIdentity(file: string): string | null {
+  if (process.platform === "win32" || !isAbsolute(file)) return null;
+  try {
+    const stat = statSync(file, { bigint: true, throwIfNoEntry: false });
+    return stat?.isFile()
+      ? `${stat.dev}:${stat.ino}:${stat.mtimeNs}:${stat.size}`
+      : null;
+  } catch {
+    return null;
+  }
+}
