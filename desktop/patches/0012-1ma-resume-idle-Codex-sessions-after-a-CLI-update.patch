+it("resumes the same thread once when an update replaces its running Codex executable", async ({
+  skip,
+}) => {
+  skip(process.platform === "win32", "Uses a POSIX executable symlink");
+
+  const command = join(workspaceDir, "codex");
+  const first = join(workspaceDir, "codex-first");
+  const second = join(workspaceDir, "codex-second");
+  for (const file of [first, second]) {
+    writeFileSync(file, `#!/bin/sh\nexec "${process.execPath}" "$@"\n`, {
+      mode: 0o700,
+    });
+  }
+  symlinkSync(first, command);
+  vi.stubEnv("BB_CODEX_BRIDGE_APP_SERVER_COMMAND", command);
+  const launchLogPath = join(workspaceDir, "launches.jsonl");
+  writeFileSync(scriptPath, JSON.stringify({ requestLogPath, launchLogPath }));
+
+  const options = {
+    ...FULL_ACCESS_SESSION_OPTIONS,
+    envVars: {
+      CODEX_HOME: join(workspaceDir, "profile"),
+      CODEX_OPENAI_BASE_URL: "http://127.0.0.1:1",
+      CODEX_POOL_AUTH_TOKEN: "local-test-token",
+    },
+  };
+  harness.sendRequest(1, "thread/start", {
+    threadId: THREAD_ID,
+    cwd: workspaceDir,
+    instructionMode: "append",
+    options,
+  });
+  const started = await harness.waitForResponse(1);
+  const { providerThreadId } = z
+    .object({ providerThreadId: z.string() })
+    .parse(started.result);
+
+  const next = join(workspaceDir, "codex-next");
+  symlinkSync(second, next);
+  renameSync(next, command);
+  rmSync(first);
+
+  for (const id of [2, 3]) {
+    harness.sendRequest(id, "turn/start", {
+      threadId: THREAD_ID,
+      providerThreadId,
+      clientRequestId: `creq_updaterxx${id}`,
+      input: [{ type: "text", text: "say hello", mentions: [] }],
+      options: { ...FULL_ACCESS_SESSION_OPTIONS },
+    });
+    expect((await harness.waitForResponse(id)).error).toBeUndefined();
+  }
+
+  const requests = recordedRequests();
+  const resumes = requests.filter(({ method }) => method === "thread/resume");
+  expect(resumes).toHaveLength(1);
+  expect(resumes[0]?.params).toMatchObject({ threadId: providerThreadId });
+  expect(requests.filter(({ method }) => method === "turn/start")).toHaveLength(
+    2,
+  );
+  expect(
+    readFileSync(launchLogPath, "utf8")
+      .trim()
+      .split("\n")
+      .map((line) => JSON.parse(line)),
+  ).toEqual(
+    Array.from({ length: 2 }, () =>
+      expect.objectContaining({
+        codexHome: options.envVars.CODEX_HOME,
+        poolToken: options.envVars.CODEX_POOL_AUTH_TOKEN,
+      }),
+    ),
+  );
+}, 30_000);
+
