      "icon": {
        "url": "./icons/1ma.svg"
      },
      "tags": ["desktop", "servers"],
      "author": {
        "name": "1ma",
        "github": "1ma-ai",
        "url": "https://1ma.ai"
      },
      "source": {
        "git": {
          "url": "https://github.com/1ma-ai/1ma.git",
          "subdir": "plugins/server-switcher",
          "range": "^0.1.0",
          "tagPrefix": "server-switcher/"
        }
      }
    }
  ]
