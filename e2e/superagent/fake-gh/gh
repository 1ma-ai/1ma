#!/usr/bin/env node
import { appendFileSync, readFileSync } from "node:fs";

const args = process.argv.slice(2);
const fixtures = process.env.E2E_GH_FIXTURES;
if (args[0] !== "api" || fixtures === undefined) {
  process.stderr.write(`fake gh: unsupported call ${args.join(" ")}\n`);
  process.exit(2);
}
const path = args.at(-1) ?? "";
if (process.env.E2E_GH_LOG !== undefined) appendFileSync(process.env.E2E_GH_LOG, `${path}\n`);
const table = JSON.parse(readFileSync(fixtures, "utf8"));
const answer = table[path] ?? table[path.split("?")[0]];
if (answer === undefined) {
  process.stderr.write(`gh: Not Found (HTTP 404) ${path}\n`);
  process.exit(1);
}
process.stdout.write(JSON.stringify(answer));
